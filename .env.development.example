# ─── KinRails — Development Environment ──────────────────────────────────────
# Copy to .env.development and fill in your values:
# cp .env.development.example .env.development

# ─── AI (RubyLLM) ────────────────────────────────────────────────────────────
# The model AI features use (docs/design/ai.md). It must be an Anthropic model, whose web search citations carry
# excerpts, for example claude-sonnet-5-5.
AI_MODEL=
# The provider for AI_MODEL.
ANTHROPIC_API_KEY=
# Moderation checks each request first (Ai::Moderation), through OpenAI's moderation model.
OPENAI_API_KEY=

# ─── Active Record encryption (session notes) ───────────────────────────────
# Only needed if these keys aren't in your development credentials.
# Generate with: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ─── Email (Action Mailer) ───────────────────────────────────────────────────
# Devise requires email for confirmation and password reset.
# In development, use letter_opener or set SMTP credentials.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_DOMAIN=example.com
# DEFAULT_FROM_EMAIL=noreply@example.com
# Every email's sender (config.x.mail_from). Unset, it's "Aglowy <hello@localhost>".
# MAIL_FROM="Aglowy <hello@aglowy.app>"

# ─── Logging ──────────────────────────────────────────────────────────────────
# Set to "true" for structured single-line JSON logs in development.
LOGRAGE_IN_DEVELOPMENT=false

# ─── Application ──────────────────────────────────────────────────────────────
# Used in mailers and Devise.
APP_HOST=localhost:3000
APP_NAME=KinRails
SUPPORT_EMAIL=support@example.com