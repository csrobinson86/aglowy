# ─── KinRails — Development Environment ──────────────────────────────────────
# Copy to .env.development and fill in your values:
# cp .env.development.example .env.development

# ─── AI (RubyLLM) ────────────────────────────────────────────────────────────
# At least one provider required for AI features.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email (Action Mailer) ───────────────────────────────────────────────────
# Devise requires email for confirmation and password reset.
# In development, use letter_opener or set SMTP credentials.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_DOMAIN=example.com
# DEFAULT_FROM_EMAIL=noreply@example.com

# ─── Logging ──────────────────────────────────────────────────────────────────
# Set to "true" for structured single-line JSON logs in development.
LOGRAGE_IN_DEVELOPMENT=false

# ─── Application ──────────────────────────────────────────────────────────────
# Used in mailers and Devise.
APP_HOST=localhost:3000
APP_NAME=KinRails
SUPPORT_EMAIL=support@example.com