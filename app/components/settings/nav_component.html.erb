<%= render(Primer::Beta::NavList.new(aria: { label: "Settings" }, selected_item_id: selected, display: [ :none, nil, :block ])) do |list| %>
  <% list.with_group do |group| %>
    <% group.with_heading(title: "You", heading_level: 2) %>
    <% sections.each do |id, label| %>
      <% group.with_item(label:, href: section_path(id), selected_by_ids: id) %>
    <% end %>
  <% end %>
<% end %>

<%= render(Primer::Alpha::ActionMenu.new(menu_id: "settings-nav-menu", select_variant: :single, anchor_align: :start, display: [ nil, nil, :none ],
      classes: "settings-nav__menu")) do |menu| %>
  <% menu.with_show_button(block: true, align_content: :start, classes: "settings-nav__button") do |button| %>
    <% button.with_trailing_action_icon(icon: :"triangle-down") %>
    <%= sections.fetch(selected) %>
  <% end %>
  <% menu.with_group do |group| %>
    <% group.with_heading(title: "You") %>
    <% sections.each do |id, label| %>
      <% group.with_item(label:, href: section_path(id), active: id == selected) %>
    <% end %>
  <% end %>
<% end %>
