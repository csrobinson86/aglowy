<%= tag.section id:, class: "daily-brief-section", aria: { labelledby: "#{id}-heading" } do %>
  <p class="daily-brief-section__kicker"><%= kicker %></p>
  <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 3, id: "#{id}-heading", classes: "wb-break-word")) { title } %>
  <% if link %>
    <p class="mt-2 mb-0">
      <%= render(Primer::Beta::Link.new(href: link.href, target: "_blank", rel: "noopener", underline: true)) { link.text } %>
      <% if link.note %><span class="color-fg-muted"> · <%= link.note %></span><% end %>
    </p>
  <% end %>
  <% if rows.any? %>
    <dl class="daily-brief-section__rows">
      <% rows.each do |row| %>
        <div class="daily-brief-section__row">
          <dt class="daily-brief-section__label"><%= row.label %></dt>
          <dd class="daily-brief-section__text">
            <%= row.text %>
            <%= safe_join(row.references.map { render "bible/references/reference", reference: it }, "; ") %>
          </dd>
        </div>
      <% end %>
    </dl>
  <% end %>
<% end %>
