<%= tag.fieldset class: "note-color-picker", data: { controller: "note-color-picker" } do %>
  <legend class="FormControl-label note-color-picker__legend">Color</legend>
  <div class="note-color-picker__swatches">
    <% colors.each do |color| %>
      <input type="radio" name="<%= name %>" id="<%= input_id(color) %>" value="<%= color %>" class="note-color-picker__input sr-only"
             <%= "checked" if color == selected %> data-action="note-color-picker#choose" data-note-color-picker-name-param="<%= color.humanize %>">
      <label for="<%= input_id(color) %>" class="note-color-picker__swatch note-color-picker__swatch--<%= color %>">
        <span class="sr-only"><%= color.humanize %></span>
      </label>
    <% end %>
    <span class="note-color-picker__chosen" data-note-color-picker-target="chosen"><%= selected.humanize %></span>
  </div>
<% end %>
