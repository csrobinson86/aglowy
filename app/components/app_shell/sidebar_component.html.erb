<div class="d-flex flex-column flex-auto height-full p-3">
  <%# Plain divs: in the phone menu a <header> or <footer> would be a second banner or contentinfo. %>
  <div class="mb-3">
    <div class="mb-3"><%= render LogoComponent.new(href: home_path) %></div>

    <%= render AppShell::HouseholdSwitcherComponent.new(membership:, menu_id: switcher_menu_id) %>
  </div>

  <%= render(Primer::Beta::NavList.new(aria: { label: }, selected_item_id: selected_item)) do |list| %>
    <% list.with_group do |group| %>
      <% group.with_heading(title: "Household", heading_level: 2) %>
      <%# Not prefetched on hover: Home marks the daily brief seen (docs/design/daily-brief.md, Trap 5). %>
      <% group.with_item(label: "Home", href: home_path, selected_by_ids: :dashboards, content_arguments: { data: { turbo_prefetch: false } }) do |item| %>
        <% item.with_leading_visual_icon(icon: :home) %>
      <% end %>
      <% group.with_item(label: "Calendar", href: calendar_path, selected_by_ids: :calendars) do |item| %>
        <% item.with_leading_visual_icon(icon: :calendar) %>
      <% end %>
      <% group.with_item(label: "Family studies", href: family_studies_path, selected_by_ids: :family_studies) do |item| %>
        <% item.with_leading_visual_icon(icon: :book) %>
      <% end %>
      <% group.with_item(label: "Members", href: members_path, selected_by_ids: %i[ members invitations ]) do |item| %>
        <% item.with_leading_visual_icon(icon: :people) %>
      <% end %>
      <% group.with_item(label: "Family goals", href: goals_path, selected_by_ids: :goals) do |item| %>
        <% item.with_leading_visual_icon(icon: :goal) %>
      <% end %>
      <%# Go bags, for everyone: children look, heads and adults change them (docs/design/go-bags.md, Pages). %>
      <% group.with_item(label: "Go bags", href: go_bags_path, selected_by_ids: :go_bags) do |item| %>
        <% item.with_leading_visual_icon(icon: :briefcase) %>
      <% end %>
    <% end %>
    <% list.with_group do |group| %>
      <% group.with_heading(title: "Mine", heading_level: 2) %>
      <% if daily_brief? %>
        <%# Not prefetched on hover: opening the brief marks it seen (docs/design/daily-brief.md, Trap 5). %>
        <% group.with_item(label: "Daily brief", href: daily_brief_path, selected_by_ids: :daily_briefs, content_arguments: { data: { turbo_prefetch: false } }) do |item| %>
          <% item.with_leading_visual_icon(icon: :"north-star") %>
        <% end %>
      <% end %>
      <% group.with_item(label: "Today's meeting", href: todays_meeting_path, selected_by_ids: :todays_meetings) do |item| %>
        <% item.with_leading_visual_icon(icon: :sun) %>
      <% end %>
      <% if study_guide? %>
        <% group.with_item(label: "Study guide", href: study_guides_path, selected_by_ids: :study_guides) do |item| %>
          <% item.with_leading_visual_icon(icon: :book) %>
        <% end %>
      <% end %>
      <% if get_ready? %>
        <% group.with_item(label: "Get ready", href: meeting_preps_path, selected_by_ids: :meeting_preps) do |item| %>
          <% item.with_leading_visual_icon(icon: :"light-bulb") %>
        <% end %>
      <% end %>
      <% group.with_item(label: "Personal study", href: personal_studies_path, selected_by_ids: :personal_studies) do |item| %>
        <% item.with_leading_visual_icon(icon: :search) %>
      <% end %>
      <%# Meeting notes are a tab of Notes, so Notes is selected on them too (docs/design/notes.md). %>
      <% group.with_item(label: "Notes", href: personal_notes_path, selected_by_ids: %i[ personal_notes meeting_notes shared_meeting_notes bookmarks ]) do |item| %>
        <% item.with_leading_visual_icon(icon: :pencil) %>
      <% end %>
      <% group.with_item(label: "Meeting parts", href: meeting_parts_path, selected_by_ids: %i[ meeting_parts shared_meeting_parts ]) do |item| %>
        <% item.with_leading_visual_icon(icon: :"comment-discussion") %>
      <% end %>
      <% group.with_item(label: "My goals", href: my_goals_path, selected_by_ids: :personal_goals) do |item| %>
        <% item.with_leading_visual_icon(icon: :flag) %>
      <% end %>
    <% end %>
  <% end %>

  <div class="mt-auto pt-3 border-top">
    <%# Notifications with its unread counter, then Settings, for everyone (docs/design/notifications.md, The sidebar;
        docs/design/settings.md, The sidebar). The counter and the hidden ", 3 unread" are replaced live. %>
    <%= render(Primer::Beta::NavList.new(aria: { label: "#{label} settings" }, selected_item_id: selected_item, mb: 2)) do |list| %>
      <% list.with_item(href: notifications_path, selected_by_ids: :notifications) do |item| %>
        <% item.with_leading_visual_icon(icon: :bell) %>
        <% item.with_trailing_visual_text(render("notifications/counter", count: unread_notifications_count)) %>
        <span class="app-shell__notifications-name"><%= render "notifications/name", count: unread_notifications_count %></span>
      <% end %>
      <% list.with_item(label: "Settings", href: settings_path, selected_by_ids: :settings) do |item| %>
        <% item.with_leading_visual_icon(icon: :gear) %>
      <% end %>
    <% end %>

    <div class="d-flex flex-items-center">
      <%= render AvatarComponent.new(user:, size: 32, classes: "mr-2") %>
      <span class="flex-auto min-width-0 mr-2 Truncate"><span class="Truncate-text"><%= user.name %></span></span>
      <%= primer_form_with(url: destroy_identity_session_path, method: :delete) do |f| %>
        <%= render Sessions::SignOutForm.new(f) %>
      <% end %>
    </div>
  </div>
</div>
