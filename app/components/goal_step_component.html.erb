<%= tag.div class: { "goal-step--yours": highlighted? }, data: { controller: "goal-step", goal_step_mixed_value: mixed?, goal_step_ticks_value: ticks.to_json } do %>
  <%= tag.div class: "d-flex flex-items-start p-3", hidden: editing?, data: { goal_step_target: "view" } do %>
    <%# Ticking it submits its form. A mixed step's checkbox is set indeterminate by its controller. %>
    <div class="flex-shrink-0 mr-2">
      <% if ticking? %>
        <% checkbox = render(Primer::Alpha::CheckBox.new(name: "#{dom_id(step)}_done", label: "Mark #{step.title} done", visually_hide_label: true,
                                                         disabled: !checkbox_tickable?, checked: done?,
                                                         data: { goal_step_target: "checkbox", action: "change->goal-step#tick" })) %>
        <%= checkbox_tickable? ? primer_form_with(**tick_form_options(step.parts.first)) { checkbox } : checkbox %>
      <% else %>
        <%= render(Primer::Beta::Octicon.new(done? ? :"check-circle-fill" : :circle, color: done? ? :success : :muted, aria: { label: done? ? "Done" : "Not done" })) %>
      <% end %>
    </div>
    <%# Avatars sit beside the text from md up, and under it on a phone (frame phone-goal.png). %>
    <div class="d-flex flex-column flex-md-row flex-auto min-width-0">
      <div class="flex-auto min-width-0">
        <%= tag.div step.title, class: [ "goal-step__title wb-break-word", { "goal-step__title--done": done? } ] %>
        <div class="goal-step__meta color-fg-muted f6"><%= meta_text %></div>
        <%# _top: the row sits in the step's Turbo Frame, and the session page replaces the whole page. %>
        <% if study %>
          <%= render(Primer::Beta::Label.new(tag: :a, href: first_session_path, scheme: :accent, size: :large, mt: 2, data: { turbo_frame: "_top" })) do %>
            <%= render(Primer::Beta::Octicon.new(:book, mr: 1)) %><%= first_session_label %>
          <% end %>
        <% end %>
        <% if several? && ticking? %>
          <div role="group" aria-label="Each person ticks their own part" class="d-flex flex-wrap mt-2">
            <% people.each do |person| %>
              <% done = step.done_for?(person) %>
              <% toggle = render(Primer::Beta::Button.new(type: :submit, disabled: !tickable?(person.id), autofocus: focused?(person.id), aria: { pressed: done.to_s }, mr: 2, mb: 1,
                                                          classes: [ "goal-step__part", { "goal-step__part--done": done } ])) do |button| %>
                <% button.with_leading_visual_icon(icon: done ? :"check-circle-fill" : :circle, color: (:success if done)) %>
                <%= done ? "#{person.name} done" : person.name %>
              <% end %>
              <%= tickable?(person.id) ? primer_form_with(**tick_form_options(person.id)) { toggle } : toggle %>
            <% end %>
          </div>
        <% end %>
      </div>
      <% if people.any? %>
        <span class="sr-only">With <%= people.map(&:name).to_sentence %></span>
        <span class="d-flex flex-shrink-0 mt-2 mt-md-0 ml-md-2" aria-hidden="true">
          <% people.each do |person| %>
            <span class="avatar avatar-4 circle d-flex flex-items-center flex-justify-center mr-1 color-bg-accent color-fg-accent text-bold f6"><%= person.name.first %></span>
          <% end %>
        </span>
      <% end %>
      <%# Beside the avatars from md up; on a phone it wraps under the step's title (frame milestone-goal.png). %>
      <% if schedulable? %>
        <%= render(Primer::Beta::Button.new(tag: :a, href: schedule_path, size: :small, mt: 2, mt_md: 0, ml_md: 2, flex_shrink: 0, align_self: :start, data: { turbo_frame: "_top" })) do |button| %>
          <% button.with_leading_visual_icon(icon: :calendar) %>
          Schedule as a family study
        <% end %>
      <% end %>
    </div>
    <% if edit_form? %>
      <%# show_tooltip: false keeps the aria-label, which Primer's tooltip would replace. %>
      <%= render(Primer::Beta::IconButton.new(icon: :pencil, scheme: :invisible, show_tooltip: false, ml: 2, "aria-label": "Edit step: #{step.title}",
                                              data: { action: "goal-step#edit", goal_step_target: "editButton" })) %>
    <% end %>
  <% end %>
  <% if edit_form? %>
    <%= tag.div edit_form, class: "p-3", hidden: !editing?, data: { goal_step_target: "form" } %>
  <% end %>
<% end %>
