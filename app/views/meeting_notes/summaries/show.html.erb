<% content_for :helper_meeting, Household::Meeting::TITLES.fetch(@meeting_note.kind) %>

<%# The end (frames tablet-done.png, tablet-game-done.png): what the child did on each step, a drawing or a mark or
    nothing, never "missed" (docs/design/meeting-helper.md, Decisions). With listening game finds, the score for this
    meeting only and "Found N" on a game step (docs/design/listening-game.md, Decisions). Drawings come through the
    authorizing drawing route, never an Active Storage URL (Trap 9). %>
<% found_count = @meeting_note.found_count %>
<div class="meeting-helper__content meeting-helper__content--summary">
  <span class="meeting-helper__icon meeting-helper__icon--attention meeting-helper__icon--small"><%= render Primer::Beta::Octicon.new(found_count.positive? ? :star : :sun) %></span>
  <% if found_count.positive? %>
    <h1 class="meeting-helper__heading">You found <%= pluralize(found_count, "thing") %> today!</h1>
    <p class="meeting-helper__lead">You listened all the way through. Here's what you did.</p>
  <% else %>
    <h1 class="meeting-helper__heading">You listened all the way through!</h1>
    <p class="meeting-helper__lead">Here's what you did today.</p>
  <% end %>

  <ul class="meeting-helper__tiles">
    <% @steps.each do |step| %>
      <li id="summary-<%= step.key %>" class="meeting-helper__tile">
        <p class="meeting-helper__tile-title"><%= meeting_helper_icon(icon: step.icon, color: step.color, size: :tiny) %><%= step.short_title %></p>
        <%# A drawing takes a mark's place, except "Gave my answer", which always shows. Under "Found N" or a drawing, the
            mark is a quieter line. %>
        <% finds, drawn, marked = @meeting_note.finds_for(step.key), @meeting_note.drawn?(step.key), @meeting_note.marked?(step.key) %>
        <% if finds.any? %>
          <p class="meeting-helper__tile-mark"><span aria-hidden="true">✓</span> Found <%= finds.size %></p>
        <% end %>
        <% if drawn %>
          <%= image_tag household_meeting_note_step_drawing_path(step_id: step.key), alt: "Your drawing", class: "meeting-helper__tile-drawing" %>
        <% elsif marked && finds.none? %>
          <p class="meeting-helper__tile-mark"><span aria-hidden="true">✓</span> <%= @meeting_note.marked_label(step) %></p>
        <% end %>
        <% if marked && (drawn ? @meeting_note.answered?(step) : finds.any?) %>
          <p class="meeting-helper__tile-note"><%= @meeting_note.marked_label(step) %></p>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="meeting-helper__actions">
    <% if @meeting_note.shared_with?(Current.household) %>
      <p class="meeting-helper__lead meeting-helper__shared" role="status">
        <%= render Primer::Beta::Octicon.new(:people, size: :medium, mr: 2) %>Your family can see it now
      </p>
    <% else %>
      <%= primer_form_with(url: household_meeting_note_sharing_path(meeting_note_id: @meeting_note)) do |f| %>
        <%= render MeetingNotes::ShowMyFamilyForm.new(f, return_to: household_meeting_note_summary_path(meeting_note_id: @meeting_note)) %>
      <% end %>
    <% end %>
    <%= render Primer::Beta::Button.new(tag: :a, href: household_root_path, size: :large, classes: "meeting-helper__button meeting-helper__button--big") do %>
      Finished
    <% end %>
  </div>
</div>
