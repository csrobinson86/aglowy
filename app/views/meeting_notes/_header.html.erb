<%# locals: (meeting_note:, edit_link: false) %>
<% title = meeting_note_title(meeting_note) %>
<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: household_meeting_notes_path) { "Meeting notes" } %>
  <% breadcrumbs.with_item(href: household_meeting_note_path(id: meeting_note)) { meeting_note.display_week } %>
<% end %>
<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1, display: :flex, align_items: :center) do %>
    <%= title %>
    <%= render(Primer::Beta::Label.new(ml: 2)) { "Private" } %>
  <% end %>
  <% if edit_link %>
    <% subhead.with_actions do %>
      <%= render(Primer::Beta::Button.new(tag: :a, href: edit_household_meeting_note_path(id: meeting_note))) do |button| %>
        <% button.with_leading_visual_icon(icon: :pencil) %>
        Edit notes
      <% end %>
    <% end %>
  <% end %>
  <% subhead.with_description do %>
    <%= meeting_note.display_week %> ·
    <%= render(Primer::Beta::Link.new(href: meeting_note.program_url, target: "_blank", rel: "noopener")) { "This week's program on wol.jw.org" } %>
  <% end %>
<% end %>
