<%# locals: (form:, outline_part:, number:) %>
<%# One part that repeats (a Living as Christians part) on the edit page. number tells the parts apart for
    screen readers; in the <template> it's a placeholder the living-parts controller fills in. A part
    removed before a failed save stays hidden. %>
<% name = "#{outline_part.label} #{number}" %>
<% title = outline_part.field(:title) %>
<fieldset class="mb-3" data-living-parts-target="part" data-new-record="<%= form.object.new_record? %>" <%= "hidden" if form.object.marked_for_destruction? %>>
  <legend class="sr-only"><%= name %></legend>
  <div class="d-flex flex-items-start">
    <div class="flex-1 min-width-0">
      <%= render MeetingNotes::NoteForm.new(form, field: :repeating_title, label: title.label, placeholder: title.placeholder) %>
      <div class="mt-3">
        <%= render "meeting_notes/notes_field", form: form, hidden_label: "for #{name}" %>
      </div>
    </div>
    <%# show_tooltip: false keeps the aria-label on the button, which Primer's tooltip would replace. %>
    <%= render(Primer::Beta::IconButton.new(icon: :x, scheme: :invisible, mt: 4, ml: 2, show_tooltip: false,
                                            "aria-label": "Remove #{name}", data: { action: "living-parts#remove" })) %>
  </div>
</fieldset>
