<% content_for :title, meeting_note_title(@meeting_note) %>

<%= render "meeting_notes/header", meeting_note: @meeting_note, edit_link: true, tags: true %>
<% reader = !policy(@meeting_note).update? %>

<%# The author's own parts that week, never on a note someone else shared (docs/design/meeting-parts.md, On the calendar
    and the meeting note). %>
<% parts = reader ? [] : @meeting_note.meeting_parts.to_a %>
<% if parts.any? %>
  <ul class="list-style-none mb-3">
    <% parts.each do |part| %>
      <li>
        <%= render(Primer::Beta::Link.new(href: household_meeting_part_path(id: part), classes: "meeting-notes__part")) do %>
          <%= render(Primer::Beta::Octicon.new(:"comment-discussion", mr: 1)) %>
          Your part this week: <%= part.kind_details.label %>, <%= part.minutes %> min
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if reader %>
  <%= render(Primer::Alpha::Banner.new(icon: :lock, mb: 4)) do %>
    <%= @meeting_note.user.name %> shared this note with <%= Current.household.name %>. You can read it but not change it.
  <% end %>
<% end %>

<% helper_used = @meeting_note.helper_used? %>
<% if helper_used %>
  <%= render "meeting_notes/from_todays_meeting", meeting_note: @meeting_note, author: !reader %>
<% end %>

<% sections = @meeting_note.filled_sections %>
<% if sections.any? %>
  <% sections.each do |section, parts| %>
    <section class="mb-4">
      <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 5, display: :flex, align_items: :center, mb: 2, classes: "text-uppercase")) do %>
        <%= meeting_note_dot(section.dot) %>
        <%= section.name %>
      <% end %>
      <% parts.each do |part| %>
        <%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 4, mt: 3, mb: 1, classes: "wb-break-word")) { [ part.label, part.title.presence ].compact.join(" · ") } %>
        <% if part.speaker.present? %>
          <p class="color-fg-muted mb-1">Speaker: <%= part.speaker %></p>
        <% end %>
        <% if part.key == "spiritual_gems" %>
          <%= render "meeting_notes/gems", gems: @meeting_note.gems %>
        <% end %>
        <%# Action Text sanitizes the notes as it renders them; never html_safe. %>
        <%= part.notes if part.notes.present? %>
      <% end %>
    </section>
  <% end %>
<%# A helper note with nothing typed isn't empty: its marks and drawings are above. %>
<% elsif !helper_used %>
  <%= render(Primer::Beta::Blankslate.new(border: true)) do |blankslate| %>
    <% blankslate.with_visual_icon(icon: :note) %>
    <% blankslate.with_heading(tag: :h2) { "Nothing written yet." } %>
  <% end %>
<% end %>

<% if reader && sections.any? %>
  <p class="f6 color-fg-muted">Parts <%= @meeting_note.user.name %> left empty aren't shown.</p>
<% end %>
