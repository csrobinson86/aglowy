<% content_for :title, "Meeting notes" %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "Meeting notes" } %>
  <% subhead.with_description { "Private to you, wherever you go. Share a note with your household when you want to." } %>
<% end %>

<%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, mb: 2)) { "This week" } %>
<div class="d-md-flex gutter-md-condensed mb-4">
  <% @this_week.each do |note| %>
    <div class="col-md-6 mb-3">
      <%= render "meeting_notes/this_week_card", note: %>
    </div>
  <% end %>
</div>

<%= render Primer::Beta::BorderBox.new do |box| %>
  <% box.with_header { |header| header.with_title(tag: :h2) { "My notes" } } %>
  <% if @earlier.records.any? %>
    <% @earlier.records.each do |note| %>
      <% box.with_row(display: :flex, align_items: :center) do %>
        <%= meeting_note_dot(MeetingNotesHelper::MEETING_NOTE_DOTS.fetch(note.kind)) %>
        <div class="d-md-flex">
          <%= render(Primer::Beta::Link.new(href: household_meeting_note_path(id: note), scheme: :primary, font_weight: :bold, mr: 3)) { meeting_note_title(note) } %>
          <div class="color-fg-muted"><%= note.display_week %></div>
        </div>
        <% if note.sharings.any? %>
          <%= render(Primer::Beta::Label.new(ml: :auto)) { "Shared" } %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <% box.with_body do %>
      <%= render(Primer::Beta::Blankslate.new(narrow: true)) do |blankslate| %>
        <% blankslate.with_visual_icon(icon: :note) %>
        <% blankslate.with_heading(tag: :h3) { "No earlier notes" } %>
        <% blankslate.with_description { "Notes from earlier weeks will show here." } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @earlier.previous? || @earlier.next? %>
  <div class="d-flex flex-justify-between mt-3">
    <% if @earlier.previous? %>
      <%= render(Primer::Beta::Button.new(tag: :a, href: household_meeting_notes_path(page: @earlier.number - 1))) { "Newer notes" } %>
    <% end %>
    <% if @earlier.next? %>
      <%= render(Primer::Beta::Button.new(tag: :a, href: household_meeting_notes_path(page: @earlier.number + 1), ml: :auto)) { "Older notes" } %>
    <% end %>
  </div>
<% end %>
