<% content_for :title, "Meeting notes" %>

<%= render layout: "meeting_notes/tab", locals: { shared: false, kind: @kind, kind_counts: @kind_counts, shared_count: @shared_count, this_week: @this_week, tags: @tags, tag: @tag_name } do %>
  <% if @tag_name %>
    <%= render "tags/filter", name: @tag_name, clear_path: household_meeting_notes_path(kind: @kind) %>
  <% end %>

  <%= render Primer::Beta::BorderBox.new do |box| %>
    <% if @earlier.records.any? && @weeks %>
      <%# A row per week, the newest on the page open (docs/design/notes.md, Earlier, a week at a time). %>
      <% @weeks.each_with_index do |(week_of, notes), index| %>
        <% box.with_row(p: 0) do %>
          <%= render MeetingNoteWeekComponent.new(week_of:, notes:, open: index.zero?) %>
        <% end %>
      <% end %>
    <% elsif @earlier.records.any? %>
      <% @earlier.records.each do |note| %>
        <% box.with_row(display: :flex, align_items: :center) do %>
          <%= meeting_note_dot(MeetingNotesHelper::MEETING_NOTE_DOTS.fetch(note.kind)) %>
          <div class="d-md-flex">
            <%= render(Primer::Beta::Link.new(href: household_meeting_note_path(id: note), scheme: :primary, font_weight: :bold, mr: 3)) { meeting_note_title(note) } %>
            <div class="color-fg-muted"><%= note.display_week %></div>
          </div>
          <div class="d-flex flex-wrap flex-items-center flex-justify-end ml-auto">
            <%= render "tags/labels", taggable: note %>
            <% if note.sharings.any? %>
              <%= render(Primer::Beta::Label.new) { "Shared" } %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <% box.with_body do %>
        <%= render(Primer::Beta::Blankslate.new(narrow: true)) do |blankslate| %>
          <% if @tag_name %>
            <% blankslate.with_visual_icon(icon: :tag) %>
            <% blankslate.with_heading(tag: :h2) { "No notes tagged ##{@tag_name}" } %>
            <% blankslate.with_description { "Add a tag from a note's page, under its title." } %>
          <% elsif @kind %>
            <% blankslate.with_visual_icon(icon: :note) %>
            <% blankslate.with_heading(tag: :h2) { "No #{MeetingNotesHelper::MEETING_NOTE_TITLES.fetch(@kind)} notes" } %>
            <% blankslate.with_description { "Notes you start for this meeting will show here." } %>
          <% else %>
            <% blankslate.with_visual_icon(icon: :note) %>
            <% blankslate.with_heading(tag: :h2) { "No earlier notes" } %>
            <% blankslate.with_description { "Notes from earlier weeks will show here." } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if @earlier.previous? || @earlier.next? %>
    <div class="d-flex flex-justify-between mt-3">
      <% if @earlier.previous? %>
        <%= render(Primer::Beta::Button.new(tag: :a, href: household_meeting_notes_path(page: @earlier.number - 1, tag: @tag_name, kind: @kind))) { @weeks ? "Newer weeks" : "Newer notes" } %>
      <% end %>
      <% if @earlier.next? %>
        <%= render(Primer::Beta::Button.new(tag: :a, href: household_meeting_notes_path(page: @earlier.number + 1, tag: @tag_name, kind: @kind), ml: :auto)) { @weeks ? "Older weeks" : "Older notes" } %>
      <% end %>
    </div>
  <% end %>
<% end %>
