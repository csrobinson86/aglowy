<% content_for :title, "Edit #{meeting_note_title(@meeting_note)}" %>
<% parts = @meeting_note.parts.group_by(&:key) %>

<%= render "meeting_notes/header", meeting_note: @meeting_note %>

<%# Drawn from the note's outline, so a new outline version needs no new markup. A part alone in its section,
    or one that repeats, has no heading of its own. Each part goes through its own fields_for, so its index,
    and the ids of its inputs and its editor, are unique on the page. %>
<%= primer_form_with(model: @meeting_note, url: household_meeting_note_path(id: @meeting_note), method: :patch) do |f| %>
  <% @meeting_note.outline.sections.each do |section| %>
    <%= render layout: "meeting_notes/section", locals: { section: } do %>
      <% section.parts.each.with_index do |outline_part, index| %>
        <%= tag.div class: { "mt-4": index.positive? } do %>
          <% if section.parts.many? && !outline_part.repeats? %>
            <div class="d-flex flex-wrap flex-items-baseline flex-justify-between mb-2">
              <%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 4, mr: 2)) { outline_part.label } %>
              <% if outline_part.hint %><p class="color-fg-muted f6 mb-0"><%= outline_part.hint %></p><% end %>
            </div>
          <% elsif outline_part.hint %>
            <p class="color-fg-muted mb-3"><%= outline_part.hint %></p>
          <% end %>

          <% if outline_part.repeats? %>
            <%= render "meeting_notes/repeating_parts", form: f, outline_part:, parts: parts.fetch(outline_part.key, []) %>
          <% elsif outline_part.field(:gems) %>
            <%= render "meeting_notes/gems_field", form: f, gems: @meeting_note.gems %>
          <% else %>
            <%= f.fields_for :parts, parts.fetch(outline_part.key, []) do |part| %>
              <%= render "meeting_notes/part_fields", form: part, outline_part: %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="d-flex flex-items-center">
    <%= render MeetingNotes::NoteForm.new(f, field: :actions) %>
    <p class="color-fg-muted f6 mb-0 ml-3">Only you can see this note.</p>
  </div>
<% end %>
