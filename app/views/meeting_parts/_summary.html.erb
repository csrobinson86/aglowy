<%# locals: (meeting_part:) -%>
<%# The top of a part's page, down to The part. Saving the details from the dialog redraws only this, so the preparation
    and counsel below keep what's typed and not yet saved. %>
<div id="meeting-part-summary">
  <%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
    <% breadcrumbs.with_item(href: household_meeting_parts_path) { "Meeting parts" } %>
    <% breadcrumbs.with_item(href: household_meeting_part_path(id: meeting_part)) { meeting_part.kind_details.label } %>
  <% end %>

  <%# The kind as the heading, Private, then the date; Edit and Delete for the owner (frame part-child.png). Sharing and the
      AI panel come in later stories. %>
  <%= render Primer::Beta::Subhead.new(mb: 3) do |subhead| %>
    <% subhead.with_heading(tag: :h1, display: :flex, flex_wrap: :wrap, align_items: :center, classes: "min-width-0") do %>
      <span class="mr-2 wb-break-word min-width-0"><%= meeting_part.kind_details.label %></span>
      <%= render(Primer::Beta::Label.new(scheme: :secondary)) { "Private" } %>
    <% end %>
    <% subhead.with_actions(display: :flex) do %>
      <%= render(Primer::Beta::Button.new(tag: :a, href: edit_household_meeting_part_path(id: meeting_part), mr: 2, data: { turbo_frame: "meeting_part_dialog" })) { "Edit" } %>
      <%= render(Primer::Alpha::Dialog.new(id: "delete-meeting-part", title: "Delete this part?")) do |dialog| %>
        <% dialog.with_show_button(scheme: :danger) { "Delete" } %>
        <% dialog.with_body { "Its preparation and counsel go too. This can't be undone." } %>
        <% dialog.with_footer do %>
          <%= render(Primer::Beta::Button.new(data: { close_dialog_id: "delete-meeting-part" })) { "Cancel" } %>
          <%= primer_form_with(url: household_meeting_part_path(id: meeting_part), method: :delete) do |f| %>
            <%= render MeetingParts::DeleteForm.new(f) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <% subhead.with_description { meeting_part_when(meeting_part.meeting_on, Current.user.today) } %>
  <% end %>

  <%= render "meeting_parts/details", meeting_part: meeting_part %>
</div>
