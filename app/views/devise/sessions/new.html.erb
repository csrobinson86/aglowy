<% content_for :title, "Sign in" %>

<div class="auth-form">
  <%= render(Primer::Beta::Heading.new(tag: :h1, font_size: 2, font_weight: :normal, text_align: :center)) { "Sign in to Aglowy" } %>
  <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, text_align: :center, mb: 4)) { "To be aglow with the spirit" } %>

  <%= render(Primer::Box.new(bg: :subtle, border: true, border_radius: 2, p: 3)) do %>
    <%= primer_form_with(model: resource, scope: resource_name, url: session_path(resource_name)) do |f| %>
      <%= render Sessions::SignInForm.new(f, forgot_password_path: new_identity_password_path) %>
    <% end %>
  <% end %>

  <%= render(Primer::Box.new(border: true, border_radius: 2, p: 3, mt: 3, text_align: :center)) do %>
    New to Aglowy?
    <%= render(Primer::Beta::Link.new(href: new_signup_path, underline: true)) { "Create an account" } %>
  <% end %>

  <p class="mt-3 text-center">
    <%= render(Primer::Beta::Link.new(href: new_identity_confirmation_path, scheme: :secondary, underline: true, font_size: :small)) { "Didn't get the confirmation email?" } %>
  </p>
</div>
