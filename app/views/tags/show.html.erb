<% content_for :title, "##{@tag.name}" %>

<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: household_settings_tags_path) { "Tags and collections" } %>
  <% breadcrumbs.with_item(href: household_tag_path(name: @tag.name)) { "##{@tag.name}" } %>
<% end %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1, classes: "wb-break-word") { "##{@tag.name}" } %>
  <% subhead.with_description { "Everything you've tagged ##{@tag.name}. Only you can see your tags." } %>
<% end %>

<%# Each group only when it has something (frame personal-study-tag.png). %>
<% if @meeting_notes.any? %>
  <%= render "tags/group", id: "meeting-notes", heading: "Meeting notes", records: @meeting_notes, row: "tags/meeting_note" %>
<% end %>
<% if @personal_studies.any? %>
  <%= render "tags/group", id: "personal-studies", heading: "Personal studies", records: @personal_studies, row: "tags/personal_study" %>
<% end %>
<% if @personal_notes.any? %>
  <%= render "tags/group", id: "personal-notes", heading: "Notes", records: @personal_notes, row: "tags/personal_note" %>
<% end %>
<% if @goals.any? %>
  <%= render "tags/group", id: "my-goals", heading: "My goals", records: @goals, row: "tags/goal" %>
<% end %>

<% if @meeting_notes.none? && @personal_studies.none? && @personal_notes.none? && @goals.none? %>
  <%= render(Primer::Beta::Blankslate.new(narrow: true)) do |blankslate| %>
    <% blankslate.with_visual_icon(icon: :tag) %>
    <% blankslate.with_heading(tag: :h2) { "Nothing tagged ##{@tag.name}" } %>
    <% blankslate.with_description { "Add it from a meeting note, a personal study, a note or a personal goal." } %>
  <% end %>
<% end %>
