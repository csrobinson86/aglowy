<%# Empties the frame, which closes the dialog, and redraws the round in place with focus back on its Change. %>
<%= turbo_stream.update "listening_game_round_dialog" %>
<%= turbo_stream.update dom_id(@round), partial: "listening_games/round", locals: { round: @round, focus: true } %>
<%# The notice takes the old one's place, first in the household layout's main, where shared/flash renders it. %>
<%= turbo_stream.remove_all "main .flash:not(.Banner)" %>
<%= turbo_stream.prepend_all "main .container-xl", partial: "shared/flash" %>
