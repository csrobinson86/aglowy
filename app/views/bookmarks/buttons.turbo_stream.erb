<% bookmarked = @bookmark.destroyed? ? {} : { @bookmark.url => @bookmark.id } %>
<%= turbo_stream.replace_all "[data-bookmark-key='#{BookmarkButtonComponent.key(@bookmark.key)}']" do %>
  <%= render BookmarkButtonComponent.new(url: @bookmark.url, title: @bookmark.title, source: @source, bookmarked:) %>
<% end %>
<%# Without a request id: with this request's, Turbo would skip the refresh as an echo of its own. %>
<% if @refresh_list %>
  <%= turbo_stream.refresh(request_id: nil) %>
<% end %>
