<%# locals: (tags:, selected:, filters:) %>
<%# The person's own tags that are on a bookmark, each with how many bookmarks carry it. %>
<% if tags.any? %>
  <h2 class="f5 mb-1 color-fg-muted">My tags</h2>
  <%= render(Primer::Beta::NavList.new(aria: { label: "My tags" }, selected_item_id: selected, mb: 2)) do |list| %>
    <% tags.each do |tag| %>
      <% list.with_item(label: "##{tag.name}", href: household_bookmarks_path(**filters, tag: tag.name), selected_by_ids: tag.name, truncate_label: true) do |item| %>
        <% item.with_trailing_visual_counter(count: tag.taggings_count, scheme: :secondary) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
