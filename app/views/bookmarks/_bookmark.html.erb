<%# locals: (bookmark:, bookmarked:) %>
<%# One bookmark on the Bookmarks tab (frame bookmarks.png): the title, or the scripture's reference, linking out, its
    site or "Scripture", when it was saved and the study or note it came from while that exists, then the filled
    button that removes it. A page's title came from a search result, so it's escaped like any AI text. %>
<% reference = bookmark.reference %>
<% site = reference ? "Scripture" : source_host(bookmark.url) %>
<%= render(Primer::Beta::Octicon.new(reference ? :book : :link, color: :muted, mr: 2, mt: 1, flex_shrink: 0)) %>
<div class="flex-auto min-width-0">
  <p class="mb-1 wb-break-word">
    <%= render(Primer::Beta::Link.new(href: reference&.jw_url || bookmark.url, target: "_blank", rel: "noopener", font_weight: :bold)) { reference&.to_s || bookmark.title.presence || site } %>
    <span class="color-fg-muted">· <%= site %></span>
  </p>
  <p class="text-small color-fg-muted mb-0">
    <%= l(bookmark.created_at.to_date, format: :short) %>
    <% if bookmark.source %>
      · from <%= render(Primer::Beta::Link.new(href: polymorphic_path([ :household, bookmark.source ]), muted: true, underline: true)) { bookmark.source.title } %>
    <% end %>
  </p>
</div>
<%= render BookmarkButtonComponent.new(url: bookmark.url, title: bookmark.title, scripture: reference, source: bookmark.source, bookmarked:, from_list: true) %>
