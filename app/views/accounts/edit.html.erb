<% content_for :title, "Account settings" %>

<%= render(Primer::Beta::Subhead.new) do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "Account settings" } %>
<% end %>

<%= render "settings/profiles/profile", user: @user, url: account_path, heading: :h2 %>
<%= render "settings/appearances/appearance", user: @user, url: account_appearance_path, heading: :h2 %>
<%= render "settings/sign_ins/sign_in", identity: @identity, url: account_sign_in_path, heading: :h2 %>
<%= render "settings/memberships/households", memberships: @memberships, namespace: [ :account ], heading: :h2 %>
