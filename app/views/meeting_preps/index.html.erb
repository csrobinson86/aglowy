<% content_for :helper_title, "Get ready" %>
<% content_for :helper_meeting, "Week of #{@week_of.strftime("%B %-d")}" %>

<%# Her Get ready page (frame tablet-prep-week.png): a tile for each of this week's meetings, the next first. %>
<div class="meeting-helper__content meeting-prep">
  <span class="meeting-helper__icon meeting-helper__icon--attention"><%= render Primer::Beta::Octicon.new(:sun) %></span>
  <h1 class="meeting-helper__heading meeting-prep__heading">Get ready for the meetings</h1>
  <p class="meeting-helper__lead">Ask Mom or Dad to read the cards with you.</p>

  <ul class="meeting-prep__tiles">
    <% @meetings.each.with_index do |meeting, index| %>
      <% cards, next_meeting = cards_for(meeting.kind), index.zero? && !meeting.passed? %>
      <%= tag.li class: [ "meeting-prep__tile", { "meeting-prep__tile--next": next_meeting && cards.any? } ] do %>
        <div class="meeting-prep__tile-header">
          <%= meeting_prep_tile_icon(meeting.kind) %>
          <div>
            <h2 class="meeting-prep__tile-title"><%= meeting.title %></h2>
            <p class="meeting-prep__tile-time"><%= meeting.starts_at.strftime("%A · %-l:%M %p") %></p>
          </div>
        </div>
        <div class="meeting-prep__tile-footer">
          <% if cards.any? %>
            <p class="meeting-prep__tile-status"><%= @commented.include?(meeting.kind) ? "My comment is ready" : pluralize(cards.size, "card") %></p>
            <%= render Primer::Beta::Button.new(tag: :a, href: household_meeting_prep_path(meeting: meeting.kind), scheme: next_meeting ? :primary : :default, size: :large, classes: "meeting-helper__button meeting-helper__button--step meeting-prep__go") do |button| %>
              <% button.with_trailing_visual_icon(icon: :"arrow-right") %>
              <%= meeting.passed? ? "Look again" : "Start" %>
            <% end %>
          <% else %>
            <p class="meeting-prep__tile-status">Cards aren't ready yet</p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </ul>
</div>
