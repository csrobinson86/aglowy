<%# locals: (card:, focus: false) -%>
<%# One card on This week's Get ready cards (frame phone-prep-check.png): the part with its tone dot, what it's about, the
    quality's words and I can, and Change. Redrawn in place when the dialog saves, with focus back on Change. %>
<% step = MeetingNote::HelperSteps.for(card.meeting).fetch(card.step) %>
<%= render(Primer::Beta::Octicon.new(:"dot-fill", color: step.color, mr: 2, flex_shrink: 0)) %>
<div class="flex-1 min-width-0">
  <p class="color-fg-muted text-small mb-0 wb-break-word"><%= [ step.title, card.reading ].compact_blank.join(" · ") %></p>
  <p class="text-bold mb-0 wb-break-word"><%= card.about %></p>
  <p class="color-fg-muted mb-0 wb-break-word"><%= card.quality_words %> · I can: <%= card.i_can %></p>
</div>
<%= render(Primer::Beta::Button.new(tag: :a, href: edit_household_meeting_prep_card_path(meeting_prep_meeting: card.meeting, id: card.step), ml: 3, flex_shrink: 0, autofocus: focus,
      "aria-label": "Change the #{step.title} card", data: { turbo_frame: "meeting_prep_card_dialog" })) { "Change" } %>
