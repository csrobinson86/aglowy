<%# locals: () %>
<%# Primer ships no handler for the Flash's close button; the flash controller removes it. %>
<% if notice %>
  <%= render Primer::Beta::Flash.new(scheme: :default, icon: :info, dismissible: true, mb: 3, data: { controller: "flash", action: "click->flash#dismiss" }) do %>
    <%= notice %>
  <% end %>
<% end %>

<% if alert %>
  <%= render Primer::Beta::Flash.new(scheme: :danger, icon: :alert, dismissible: true, mb: 3, data: { controller: "flash", action: "click->flash#dismiss" }) do %>
    <%= alert %>
  <% end %>
<% end %>
