<% content_for :title, "Meetings · Settings" %>

<%= render Settings::PageComponent.new(membership: Current.membership, section: :meetings) do |page| %>
  <% page.with_body do %>
    <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
      <% box.with_header { |header| header.with_title(tag: :h3) { "Meetings" } } %>
      <% box.with_body do %>
        <p class="color-fg-muted">
          When your congregation meets. "Today's meeting" uses these to open the right meeting for everyone in the household.
          Times are in the household's time zone.
        </p>
        <%= primer_form_with(model: @household, url: household_settings_meetings_path, method: :patch) do |f| %>
          <%= render Settings::MeetingTimesForm.new(f) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
