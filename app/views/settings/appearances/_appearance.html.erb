<%# locals: (user:, url:, heading: :h3) %>
<%# The Appearance box, in Settings and on /account (frames settings-child.png, settings-appearance-dark.png). %>
<%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
  <% box.with_header { |header| header.with_title(tag: heading) { "Appearance" } } %>
  <% box.with_body do %>
    <%= primer_form_with(model: user, url:, method: :patch) do |f| %>
      <%= render Settings::AppearanceForm.new(f) %>
    <% end %>
  <% end %>
<% end %>
