<%# locals: (user:, error: nil, photo_error: nil) %>
<%# The Avatar box, above Profile (docs/design/avatars.md, The Avatar box and The preview dialog; frames
    settings-avatar.png, settings-avatar-photo.png, avatar-preview.png): the person's avatar as saved, a photo to upload,
    change or remove, and the color for their initial while there's no photo. Choosing a file opens the preview dialog;
    nothing is uploaded until Save avatar. A refused photo shows why under the picker, a refused color above the swatches. %>
<% photo = user.avatar.attached? %>
<%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
  <% box.with_header { |header| header.with_title(tag: :h3) { "Avatar" } } %>
  <%# Side by side; on a phone, stacked and centered (frame phone-avatar.png). %>
  <% box.with_row(display: :flex, direction: [ :column, :row ], align_items: :center, text_align: [ :center, :left ]) do %>
    <%= render AvatarComponent.new(user:, size: 80, alone: true, classes: "flex-shrink-0 mb-3 mb-sm-0 mr-sm-3") %>
    <div>
      <div class="d-flex flex-wrap flex-justify-center flex-sm-justify-start mb-2">
        <%= primer_form_with(scope: :avatar, url: household_settings_avatar_path, method: :patch, multipart: true, class: "mr-2",
                             data: { controller: "avatar-preview", avatar_preview_max_size_value: User::Avatarable::PHOTO_MAX_SIZE }) do |f| %>
          <label for="avatar_photo" class="sr-only">Avatar photo</label>
          <input type="file" id="avatar_photo" name="avatar[photo]" class="sr-only" tabindex="-1" accept="<%= User::Avatarable::PHOTO_TYPES.join(",") %>"
                 aria-describedby="<%= [ "avatar_photo_hint", ("avatar_photo_error" if photo_error) ].compact.join(" ") %>"
                 data-avatar-preview-target="input" data-action="avatar-preview#preview">
          <%= render(Primer::Beta::Button.new(type: :button, data: { action: "avatar-preview#choose" })) { photo ? "Change photo" : "Upload photo" } %>

          <%= render "settings/avatars/preview_dialog", form: f, id: "avatar-preview", title: "New avatar",
                                                        image_alt: "Your new avatar", seen_by: "your households" %>
        <% end %>
        <% if photo %>
          <%= primer_form_with(url: household_settings_avatar_path, method: :delete) do |f| %>
            <%= render Settings::AvatarRemovalForm.new(f) %>
          <% end %>
        <% end %>
      </div>
      <% if photo_error %>
        <p id="avatar_photo_error" class="FormControl-inlineValidation mb-2">
          <%= render(Primer::Beta::Octicon.new(icon: :"alert-fill", size: :xsmall)) %>
          <span><%= photo_error %></span>
        </p>
      <% end %>
      <div id="avatar_photo_hint" class="f6 color-fg-muted">
        <p class="mb-1">
          JPEG, PNG, WebP or HEIC, up to 10 MB. Aglowy keeps the middle of the photo as a square and removes its location
          and camera details.
        </p>
        <p class="mb-0">Everyone in your households sees your avatar.</p>
      </div>
    </div>
  <% end %>
  <% unless photo %>
    <% box.with_row do %>
      <% if error %>
        <%= render(Primer::Alpha::Banner.new(scheme: :danger, mb: 3)) { error } %>
      <% end %>
      <%= primer_form_with(scope: :avatar, url: household_settings_avatar_path, method: :patch) do |f| %>
        <div class="mb-3">
          <%= render ColorPickerComponent.new(name: "avatar[color]", selected: user.avatar_color, colors: Avatar::Palette::COLORS,
                                              legend: "Color for your initial", swatch_label: user.initial) %>
        </div>
        <%= render Settings::AvatarForm.new(f) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
