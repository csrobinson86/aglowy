<% content_for :title, "Children · Settings" %>

<%= render Settings::PageComponent.new(membership: Current.membership, section: :children) do |page| %>
  <% page.with_body do %>
    <%= render "settings/children/avatars", children: @children, refused: @child %>
    <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
      <% box.with_header { |header| header.with_title(tag: :h3) { "Children" } } %>
      <% box.with_body do %>
        <%= primer_form_with(scope: :meeting_helper, url: household_settings_meeting_helper_path, method: :patch) do |f| %>
          <%= render Settings::MeetingHelperForm.new(f, meeting_helper: Current.household.meeting_helper, meeting_prep: Current.household.meeting_prep) %>
        <% end %>
        <% if Current.household.meeting_helper? %>
          <p class="mt-3 mb-0">
            <%= render(Primer::Beta::Link.new(href: household_listening_game_path, underline: true)) { "Check this week's listening game" } %>
          </p>
        <% end %>
      <% end %>
      <% box.with_row do %>
        <%= render "settings/children/study_ai", children: @children, head: policy(Current.household).update? %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
