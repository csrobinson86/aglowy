<%# locals: (question:) -%>
<%# An answer as it's saved to the study's note (PersonalStudy::Question#save_to_note): its question as a heading, then
    the answer. Every field is the person's or the AI's text, escaped here; references stay plain text, linked when the
    note is saved. %>
<h2><%= question.prompt %></h2>
<% if question.answer["not_found_note"].present? %><p><%= question.answer["not_found_note"] %></p><% end %>
<% question.answer["paragraphs"].each do |paragraph| %><p><%= paragraph %></p><% end %>
<% if question.sources.any? %>
  <p>Pages:</p>
  <ul>
    <% question.sources.each do |source| %>
      <li><%= link_to source["title"].presence || source_host(source["url"]), source["url"] %></li>
    <% end %>
  </ul>
<% end %>
