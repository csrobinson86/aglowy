<%# locals: (question:, household: nil) -%>
<%# One question in a study's conversation and its answer card (frame personal-study.png). The job's result broadcast
    replaces it once the answer is checked; household is only for Stop, which shows only while it's asking. %>
<div id="<%= dom_id(question) %>" class="study-question">
  <div class="d-flex flex-justify-end pl-6 mb-3">
    <p class="color-bg-subtle border rounded-3 px-3 py-2 mb-0 wb-break-word"><%= question.prompt %></p>
  </div>
  <%= render PersonalStudies::AnswerComponent.new(question:, household:) %>
</div>
