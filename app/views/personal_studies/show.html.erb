<% content_for :title, @personal_study.title_in_database %>
<%# The person's bookmarks, read once for every bookmark button on the page (docs/design/bookmarks.md, The bookmark
    button). Only the owner reaches this page. %>
<% bookmarked = Current.user.bookmarked %>
<%# The study note's editor opens in its frame, and Turbo keeps only the frame from that response, so the picker its
    Scripture button opens is here from the start (docs/design/scripture-links.md). %>
<% content_for :scripture_picker, render(ScripturePickerComponent.new) %>

<%# The study-layout controller arranges the header and the tabs for a phone or md up. %>
<div data-controller="study-layout">
  <%= render "personal_studies/header", personal_study: @personal_study %>
  <%= render "personal_studies/read_by_heads" %>
  <%= render "personal_studies/errors", personal_study: @personal_study %>

  <%# The conversation and the ask box, with the study's note and sources beside them (frame personal-study.png).
      On a phone they're Conversation, Note and Sources tabs, with the ask box at the bottom of Conversation (frame
      phone-personal-study.png); from md up the tabs are hidden and every panel shows (_personal_studies.scss). The
      study-ask controller fills the box from an answer's next questions, and "See sources" opens the Sources tab. %>
  <div data-controller="study-ask">
    <%= render(Primer::Alpha::UnderlinePanels.new(label: "Study", wrapper_arguments: { classes: "personal-study-tabs" }, classes: "personal-study-tabs__nav", mb: 3)) do |panels| %>
      <% panels.with_tab(id: "study-tab-conversation", selected: true) do |tab| %>
        <% tab.with_text { "Conversation" } %>
        <% tab.with_panel(classes: "personal-study-tabs__conversation", data: { study_layout_target: "panel" }) do %>
          <section aria-labelledby="study-conversation" class="mb-3">
            <%= render(Primer::Beta::Heading.new(tag: :h2, classes: "sr-only", id: "study-conversation")) { "Conversation" } %>
            <% @personal_study.conversation.each do |question| %>
              <%= render "personal_studies/questions/question", question:, household: Current.household, bookmarked: %>
            <% end %>
          </section>
          <%= render "personal_studies/ask", personal_study: @personal_study, question: @question || PersonalStudy::Question.new %>
        <% end %>
      <% end %>
      <% panels.with_tab(id: "study-tab-note") do |tab| %>
        <% tab.with_text { "Note" } %>
        <% tab.with_panel(classes: "personal-study-tabs__notes", data: { study_layout_target: "panel" }) do %>
          <%= turbo_frame_tag @personal_study, :note_panel do %>
            <%= render "personal_studies/notes/note", personal_study: @personal_study %>
          <% end %>
        <% end %>
      <% end %>
      <% panels.with_tab(id: "study-tab-sources", data: { study_ask_target: "sourcesTab" }) do |tab| %>
        <% tab.with_text { "Sources" } %>
        <% tab.with_panel(classes: "personal-study-tabs__sources", data: { study_layout_target: "panel" }) do %>
          <%= render "personal_studies/scriptures", personal_study: @personal_study, bookmarked: %>
          <%= render "personal_studies/sources", personal_study: @personal_study, bookmarked: %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
