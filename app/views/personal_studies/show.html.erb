<% content_for :title, @personal_study.title_in_database %>

<%= render "personal_studies/header", personal_study: @personal_study %>
<%= render "personal_studies/errors", personal_study: @personal_study %>

<%# The conversation and the ask box, with My notes and the study's sources beside them (frame personal-study.png);
    under them on a phone. The study-ask controller fills the box from an answer's next questions. %>
<div data-controller="study-ask">
  <%= render(Primer::Alpha::Layout.new(stacking_breakpoint: :md, classes: "personal-study")) do |layout| %>
    <% layout.with_main do %>
      <section aria-labelledby="study-conversation" class="mb-3">
        <%= render(Primer::Beta::Heading.new(tag: :h2, classes: "sr-only", id: "study-conversation")) { "Conversation" } %>
        <% @personal_study.conversation.each do |question| %>
          <%= render "personal_studies/questions/question", question:, household: Current.household %>
        <% end %>
      </section>
      <%= render "personal_studies/ask", personal_study: @personal_study, question: @question || PersonalStudy::Question.new %>
    <% end %>

    <% layout.with_sidebar(width: :wide, col_placement: :end, row_placement: :end, classes: "personal-study__sidebar") do %>
      <%= render "personal_studies/notes", personal_study: @personal_study %>
      <%= render "personal_studies/sources", personal_study: @personal_study %>
    <% end %>
  <% end %>
</div>
