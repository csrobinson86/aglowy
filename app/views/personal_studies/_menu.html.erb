<%# locals: (personal_study:, phone: false) %>
<%# The study's "…" menu: in the header from md up, and in the back row on a phone (docs/design/phone.md, A personal
    study), where it's a plain icon with its own menu_id. First, for heads and adults here, "Create family study", a
    link out of the study with a divider under it (docs/design/personal-study.md, Create family study). Each item below
    opens one of the page's dialogs (personal_studies/_dialogs); Delete asks first, never a browser confirm. On a phone
    it also holds Tags, which sits in the header from md up (frame phone-personal-study.png). %>
<%= render(Primer::Alpha::ActionMenu.new(menu_id: phone ? "personal-study-phone-menu" : "personal-study-menu", anchor_align: :end, classes: "personal-study__menu")) do |menu| %>
  <% menu.with_show_button(icon: :"kebab-horizontal", scheme: phone ? :invisible : :default, "aria-label": "Study actions", show_tooltip: false) %>
  <% if policy(FamilyStudy).create? %>
    <% menu.with_item(label: "Create family study", href: new_household_family_study_path(from_study: personal_study.id)) do |item| %>
      <% item.with_leading_visual_icon(icon: :book) %>
    <% end %>
    <% menu.with_divider %>
  <% end %>
  <% if phone %>
    <% menu.with_item(label: "Tags…", tag: :button, content_arguments: { "data-show-dialog-id": "personal-study-tags" }) do |item| %>
      <% item.with_leading_visual_icon(icon: :tag) %>
    <% end %>
  <% end %>
  <% menu.with_item(label: "Rename…", tag: :button, content_arguments: { "data-show-dialog-id": "rename-personal-study" }) do |item| %>
    <% item.with_leading_visual_icon(icon: :pencil) %>
  <% end %>
  <% menu.with_item(label: "Move to collection…", tag: :button, content_arguments: { "data-show-dialog-id": "move-personal-study" }) do |item| %>
    <% item.with_leading_visual_icon(icon: :"file-directory") %>
  <% end %>
  <% menu.with_divider %>
  <% menu.with_item(label: "Delete study…", tag: :button, scheme: :danger, content_arguments: { "data-show-dialog-id": "delete-personal-study" }) do |item| %>
    <% item.with_leading_visual_icon(icon: :trash) %>
  <% end %>
<% end %>
