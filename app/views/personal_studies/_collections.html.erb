<%# locals: (collections:, selected:, total_count:, tag:) %>
<%# The person's collections for Personal study, each with how many studies are in it. A shared one carries an icon
    labelled "Shared with Notes", explained under the list (docs/design/personal-study.md, Collection). %>
<h2 class="f5 mb-1 color-fg-muted">Collections</h2>
<%= render(Primer::Beta::NavList.new(aria: { label: "Collections" }, selected_item_id: selected ? dom_id(selected) : :all_studies, mb: 2)) do |list| %>
  <% list.with_item(label: "All studies", href: household_personal_studies_path(tag:), selected_by_ids: :all_studies) do |item| %>
    <% item.with_trailing_visual_counter(count: total_count, scheme: :secondary) %>
  <% end %>
  <% collections.each do |collection| %>
    <% list.with_item(label: collection.name, href: household_personal_studies_path(collection: collection.id, tag:), selected_by_ids: dom_id(collection), truncate_label: true) do |item| %>
      <% item.with_trailing_visual_text(safe_join([ (render(Primer::Beta::Octicon.new(:duplicate, mr: 1, "aria-label": "Shared with Notes")) if collection.used_in_both?), collection.personal_studies_count ])) %>
    <% end %>
  <% end %>
<% end %>

<% if collections.any?(&:used_in_both?) %>
  <p class="f6 color-fg-muted mb-2 px-2">
    <%= render(Primer::Beta::Octicon.new(:duplicate, size: :xsmall, mr: 1)) %>Also used in Notes
  </p>
<% end %>

<%# The dialog is on the page (personal_studies/index), since "+ New ▾" opens it too on a phone. %>
<%= render(Primer::Beta::Button.new(scheme: :invisible, mb: 4, data: { "show-dialog-id": "new-collection-dialog" })) do |button| %>
  <% button.with_leading_visual_icon(icon: :plus) %>
  New collection
<% end %>
