<%# locals: (personal_study:, read_only: false) %>
<%# The study's note read-only beside the conversation (frames personal-study-no-note.png, personal-study-note.png):
    its body as saved, with working scripture links, drawn like its card in Notes, with Open in Notes and Edit; or "No
    note yet" with Start a note. Edit and Start a note open the editor in the panel's frame. Save to note replaces this
    section by its id, which only the read view has, so a save while the editor is open leaves the editor alone
    (docs/design/personal-study.md, Traps). read_only: a head reading a child's study, with nothing to press. %>
<% note = personal_study.note %>
<section id="<%= dom_id(personal_study, :note) %>" aria-labelledby="study-note" class="note-card note-card--<%= note&.drawn_color || "none" %> p-0 mb-3">
  <div class="d-flex flex-items-center px-3 py-2 border-bottom">
    <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, flex: :auto, id: "study-note")) { "Study note" } %>
    <%= render "personal_notes/color_name", personal_note: note if note %>
    <% if note && !read_only %>
      <%= render(Primer::Beta::Link.new(href: household_personal_note_path(id: note), font_size: :small, mr: 3, data: { turbo_frame: "_top" })) { "Open in Notes" } %>
      <%= render(Primer::Beta::Button.new(tag: :a, href: edit_household_personal_study_note_path(personal_study_id: personal_study), size: :small)) { "Edit" } %>
    <% end %>
  </div>
  <% if note %>
    <div class="p-3 wb-break-word"><%= note.body %></div>
    <p class="f6 color-fg-muted px-3 py-2 border-top mb-0">
      In Notes · Edited <%= render(Primer::Beta::RelativeTime.new(datetime: note.updated_at, tense: :past)) %>
    </p>
  <% elsif read_only %>
    <p class="color-fg-muted p-3 mb-0">No note yet.</p>
  <% else %>
    <div class="p-3">
      <p class="color-fg-muted mb-2">No note yet. Save an answer to start one, or write your own.</p>
      <%= primer_form_with(url: household_personal_study_note_path(personal_study_id: personal_study)) do |f| %>
        <%= render PersonalStudies::NoteStartForm.new(f) %>
      <% end %>
    </div>
  <% end %>
</section>
