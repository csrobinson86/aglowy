<%# locals: (personal_study:, bookmarked:) %>
<%# Every scripture the study's answers link, once each, as scripture links with a bookmark button beside each (frame
    personal-study-bookmarks.png). The owner's alone: a head reading a child's study doesn't get it. Caught up from
    the page when an answer arrives, like Sources in this study. %>
<% references = personal_study.scripture_references %>
<section id="<%= dom_id(personal_study, :scriptures) %>" aria-labelledby="study-scriptures" class="mb-3" data-study-ask-catch-up>
  <%= render(Primer::Beta::BorderBox.new) do |box| %>
    <% box.with_header do %>
      <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, id: "study-scriptures")) { "Scriptures in this study" } %>
    <% end %>
    <% references.each do |reference| %>
      <% box.with_row(display: :flex, align_items: :baseline) do %>
        <%= render "bible/references/reference", reference: %>
        <%= render BookmarkButtonComponent.new(scripture: reference, source: personal_study, bookmarked:) %>
      <% end %>
    <% end %>
    <% box.with_footer(font_size: :small, color: :muted) do %>
      <% if references.none? %>The scriptures each answer links show here. <% end %>Each opens on jw.org, or in JW Library if it's installed.
    <% end %>
  <% end %>
</section>
