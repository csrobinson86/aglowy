<% content_for :title, "New study" %>

<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: household_personal_studies_path) { "Personal study" } %>
  <% breadcrumbs.with_item(href: new_household_personal_study_path) { "New study" } %>
<% end %>
<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "New study" } %>
<% end %>

<div class="container-md ml-0">
  <%= render "personal_studies/errors", personal_study: @personal_study %>
  <%= primer_form_with(model: @personal_study, url: household_personal_studies_path) do |f| %>
    <%# A question at the day's limit would only be refused, so none is offered then. %>
    <% user = Current.user %>
    <% asks = user.may_ask_study_ai? && user.accepted_ai_terms? && user.study_questions_left_today.positive? %>
    <%= render PersonalStudies::StudyForm.new(f, submit_label: "Start study", collections: user.collections.for_studies.positioned,
                                                 fields: asks ? %i[ title collection question ] : %i[ title collection ],
                                                 first_question: @first_question, cancel_path: household_personal_studies_path) %>
  <% end %>
</div>
