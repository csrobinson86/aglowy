<% content_for :title, "Personal study" %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "Personal study" } %>
  <% subhead.with_description { "Your own research, with notes, collections and tags.#{" Only you can see it." unless Current.user.personal_study_read_by_heads?}" } %>
  <% subhead.with_actions do %>
    <%= render(Primer::Beta::Button.new(tag: :a, href: new_household_personal_study_path(collection: @collection&.id), scheme: :primary)) { "New study" } %>
  <% end %>
<% end %>

<%= render "personal_studies/read_by_heads" %>

<%# Collections and my tags beside the list (frame personal-studies.png). On a phone they're above it, behind
    "Collections and tags"; from md up the open-from-md controller keeps them open, with the summary hidden. %>
<%= render(Primer::Alpha::Layout.new(stacking_breakpoint: :md, classes: "personal-studies")) do |layout| %>
  <% layout.with_sidebar(width: :narrow, row_placement: :start, classes: "personal-studies__sidebar") do %>
    <%= render(Primer::Beta::Details.new(data: { controller: "open-from-md" })) do |details| %>
      <% details.with_summary(block: true, mb: 3, display: [ nil, nil, :none ]) { "Collections and tags" } %>
      <% details.with_body do %>
        <%= render "personal_studies/collections", collections: @collections, selected: @collection, total_count: @total_count, tag: @tag_name %>
        <%= render "personal_studies/tags", tags: @tags, selected: @tag_name, collection: @collection %>
      <% end %>
    <% end %>
  <% end %>

  <% layout.with_main do %>
    <%= primer_form_with(url: household_personal_studies_path, method: :get, class: "mb-3") do |f| %>
      <%= render PersonalStudies::SearchForm.new(f, query: @query, collection: @collection_id, tag: @tag_name) %>
    <% end %>

    <% if @collection %>
      <%= render "collections/header", collection: @collection %>
    <% end %>
    <% if @tag_name %>
      <%= render "tags/filter", name: @tag_name, clear_path: household_personal_studies_path(collection: @collection_id, q: @query) %>
    <% end %>

    <% if @personal_studies.any? %>
      <%= render Primer::Beta::BorderBox.new do |box| %>
        <% @personal_studies.each do |personal_study| %>
          <% box.with_row { render "personal_studies/row", personal_study: } %>
        <% end %>
      <% end %>
    <% elsif @total_count.zero? %>
      <%= render(Primer::Beta::Blankslate.new(border: true)) do |blankslate| %>
        <% blankslate.with_visual_icon(icon: :search) %>
        <% blankslate.with_heading(tag: :h2) { "No studies yet." } %>
        <% blankslate.with_description { "Start one with a question or a topic you'd like to research." } %>
        <% blankslate.with_primary_action(href: new_household_personal_study_path) { "New study" } %>
      <% end %>
    <% else %>
      <%= render(Primer::Beta::Blankslate.new(border: true)) do |blankslate| %>
        <% blankslate.with_visual_icon(icon: :search) %>
        <% blankslate.with_heading(tag: :h2) { "No studies match" } %>
        <% blankslate.with_description { "Search titles, collections and tags, or show all studies." } %>
        <% blankslate.with_secondary_action(href: household_personal_studies_path) { "All studies" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
