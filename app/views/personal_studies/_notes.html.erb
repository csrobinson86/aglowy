<%# locals: (personal_study:) %>
<%# The study's note beside the conversation: a link to it in Notes, or how to start one. Save to note on an answer
    card replaces it (PersonalStudies::NoteSavingsController). %>
<section id="<%= dom_id(personal_study, :note) %>" aria-labelledby="study-note" class="mb-3">
  <%= render(Primer::Beta::BorderBox.new) do |box| %>
    <% box.with_header do %>
      <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, id: "study-note")) { "Study note" } %>
    <% end %>
    <% box.with_body do %>
      <% if personal_study.note %>
        <%= render(Primer::Beta::Link.new(href: household_personal_note_path(id: personal_study.note))) { personal_study.note.title } %>
      <% else %>
        <p class="color-fg-muted mb-0">No note yet. Save an answer to start one.</p>
      <% end %>
    <% end %>
  <% end %>
</section>
