<%# locals: (title:, lead:, action:, reason:) -%>
<%# Email styles are inline (REVIEW.md, Patterns). The sun is a character, so the email has no images at all. %>
<div style="max-width: 560px; margin: 0 auto; border: 1px solid #d1d9e0; border-radius: 8px; background: #ffffff; color: #1f2328; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.5;">
  <p style="margin: 0; padding: 16px 32px; border-bottom: 1px solid #d1d9e0; font-size: 18px; font-weight: 600;"><span aria-hidden="true" style="color: #9a6700;">&#9728;</span> Aglowy</p>

  <div style="padding: 24px 32px;">
    <h1 style="margin: 0 0 16px; font-size: 24px; line-height: 1.25;"><%= title %></h1>
    <p style="margin: 0 0 16px; color: #59636e;"><%= lead %></p>

    <%= yield %>

    <p style="margin: 24px 0 0;">
      <%= link_to action, @open_url, style: "display: inline-block; padding: 12px 24px; border-radius: 6px; background: #1f883d; color: #ffffff; font-weight: 600; text-decoration: none;" %>
    </p>
  </div>

  <p style="margin: 0; padding: 16px 32px; border-top: 1px solid #d1d9e0; border-radius: 0 0 8px 8px; background: #f6f8fa; color: #59636e; font-size: 14px;">
    <%= reason %>
    <%= link_to "Turn off this email", unsubscribe_url, style: "color: #0969da;" %> &middot;
    <%= link_to "Notification settings", notification_settings_url, style: "color: #0969da;" %>
  </p>
</div>
