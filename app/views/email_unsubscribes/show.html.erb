<% content_for :title, "Turn off this email" %>

<%= render(Primer::Beta::Blankslate.new(border: true)) do |blankslate| %>
  <% blankslate.with_visual_icon(icon: :"bell-slash") %>
  <% blankslate.with_heading(tag: :h1) { "Turn off #{email_name}?" } %>
  <% blankslate.with_description do %>
    You'll still see these notifications in Aglowy. You can turn the email back on in Settings → Notifications.
    <%# Not a Turbo form: it answers with a page, not a redirect, as the mail client's one-click POST expects. %>
    <%= primer_form_with(url: email_unsubscribe_path(scope: params[:scope], token: params[:token]), data: { turbo: false }, class: "mt-3") do |f| %>
      <%= render EmailUnsubscribes::UnsubscribeForm.new(f) %>
    <% end %>
  <% end %>
<% end %>
