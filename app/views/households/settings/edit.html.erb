<% content_for :title, "Household settings" %>

<%= render(Primer::Beta::Subhead.new) do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "Household settings" } %>
<% end %>

<% head = policy(Current.household).update? %>

<% unless head %>
  <p class="color-fg-muted mb-4"><%= "A head changes the household's name, time zone and roles. Adults can set the meeting times and turn on the meeting helper for children." %></p>
<% end %>

<% if head %>
  <%= render(Primer::Beta::BorderBox.new(id: "name-and-time-zone", mb: 4)) do |box| %>
    <% box.with_header { |header| header.with_title(tag: :h2) { "Household" } } %>
    <% box.with_body do %>
      <%= primer_form_with(model: @household, url: household_settings_path, method: :patch) do |f| %>
        <%= render Households::SettingsForm.new(f) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(id: "meetings", mb: 4)) do |box| %>
  <% box.with_header { |header| header.with_title(tag: :h2) { "Meetings" } } %>
  <% box.with_body do %>
    <p class="color-fg-muted">
      When your congregation meets. "Today's meeting" uses these to open the right meeting for everyone in the household.
      Times are in the household's time zone.
    </p>
    <%= primer_form_with(model: @household, url: household_meeting_times_path, method: :patch) do |f| %>
      <%= render Households::MeetingTimesForm.new(f) %>
    <% end %>
  <% end %>
<% end %>

<% meeting_helper = Current.household.meeting_helper %>
<%= render(Primer::Beta::BorderBox.new(id: "children", mb: 4)) do |box| %>
  <% box.with_header { |header| header.with_title(tag: :h2) { "Children" } } %>
  <% box.with_body do %>
    <%= primer_form_with(scope: :meeting_helper, url: household_meeting_helper_path, method: :patch) do |f| %>
      <%= render Households::MeetingHelperForm.new(f, enabled: meeting_helper.present?) %>
    <% end %>
    <% if meeting_helper %>
      <p class="f6 color-fg-muted mt-3 mb-0">
        Turned on by <%= meeting_helper.enabled_by.name %> on <%= meeting_helper.created_at.in_time_zone(Current.household.time_zone).strftime("%B %-d") %>.
      </p>
    <% end %>
  <% end %>
<% end %>

<% if head %>
  <%= render(Primer::Beta::BorderBox.new(id: "members-and-roles", mb: 4)) do |box| %>
    <% box.with_header { |header| header.with_title(tag: :h2) { "Members and roles" } } %>
    <% @memberships.each do |member| %>
      <% box.with_row(p: 0) { render "households/settings/member", member: } %>
    <% end %>
    <% box.with_footer(font_size: :small, color: :muted) do %>
      A household always keeps at least one head. Removing someone works like them leaving: their shares here end and
      their open steps go back to the family. Their own notes and goals stay with them.
    <% end %>
  <% end %>
<% end %>
