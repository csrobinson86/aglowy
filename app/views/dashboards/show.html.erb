<% content_for :title, "Home" %>
<%# Saving a time or an event from Today's dialogs refreshes Home, keeping the place on it. %>
<% turbo_refreshes_with method: :replace, scroll: :preserve %>

<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "Home" } %>
  <% subhead.with_description { "#{Current.household.name} · #{Current.household.today.strftime("%A, %B %-d")}" } %>
  <%# On the Welcome empty state the Schedule action is the Blankslate's; everywhere else it's in the header, as in the app shell frames. %>
  <% if !@welcome && policy(FamilyStudy).create? %>
    <% subhead.with_actions do %>
      <%= render(Primer::Beta::Button.new(tag: :a, href: new_household_family_study_path, scheme: :primary)) do |button| %>
        <% button.with_leading_visual_icon(icon: :plus) %>
        Schedule a study
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%# The person's own daily brief, first (docs/design/daily-brief.md, On Home). Kept out of Turbo's snapshot cache, as
    the brief's page is, so Back after a sign-out and another person's sign-in can't show it. %>
<% if @daily_brief %>
  <% turbo_exempts_page_from_cache %>
  <%= render DailyBriefs::HomeCardComponent.new(brief: @daily_brief, href: household_daily_brief_path) %>
<% end %>

<% if @todays_meeting %>
  <%= render "dashboards/todays_meeting", meeting: @todays_meeting, meeting_helper: meeting_helper? %>
<% end %>

<% if @welcome %>
  <%= render Primer::Beta::Blankslate.new(border: true, spacious: true) do |blankslate| %>
    <% blankslate.with_visual_icon(icon: :home) %>
    <% blankslate.with_heading(tag: :h2) { "Welcome to #{Current.household.name}" } %>
    <% if policy(Membership).create? %>
      <% blankslate.with_description { "Add the people in your household. Family studies, goals and notes will show up here as you add them." } %>
      <% blankslate.with_secondary_action(href: new_household_member_path) { "Add a member" } %>
    <% else %>
      <% blankslate.with_description { "Family studies, goals and notes will show up here." } %>
    <% end %>
    <% if policy(FamilyStudy).create? %>
      <% blankslate.with_primary_action(href: new_household_family_study_path) do |button| %>
        <% button.with_leading_visual_icon(icon: :plus) %>
        Schedule a study
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%# Family studies on the left, then family goals and the person's own content; stacked in that order below lg (frame desktop-light.png). %>
  <%= render Primer::Alpha::Layout.new(stacking_breakpoint: :lg, first_in_source: :main, classes: "household-home") do |layout| %>
    <% layout.with_main do %>
      <% if @next_session %>
        <%= render "dashboards/next_session", study_session: @next_session %>
      <% else %>
        <%= render Primer::Beta::BorderBox.new(mb: 4) do |box| %>
          <% box.with_header { |header| header.with_title(tag: :h2) { "Next family study" } } %>
          <% box.with_body(color: :muted) { "No family study scheduled." } %>
        <% end %>
      <% end %>

      <% if @coming_up.any? %>
        <%= render Primer::Beta::BorderBox.new do |box| %>
          <% box.with_header { |header| header.with_title(tag: :h2) { "Coming up" } } %>
          <% @coming_up.each do |study_session| %>
            <% box.with_row { render "family_study/sessions/session", study_session: } %>
          <% end %>
          <% box.with_footer do %>
            <%= render(Primer::Beta::Link.new(href: household_family_studies_path)) { "All family studies" } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% layout.with_sidebar(width: :wide, col_placement: :end, row_placement: :end, classes: "household-home__aside") do %>
      <%= render "dashboards/family_goals", goals: @family_goals %>
      <%= render "dashboards/mine", goals: @my_goals, pinned_notes: @pinned_notes, meeting_notes: @meeting_notes %>
    <% end %>
  <% end %>
<% end %>
