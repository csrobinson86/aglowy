<%# locals: () %>
<%# Home's New menu (docs/design/app-shell.md, Home's New menu): each item has its sidebar icon and shows only when the
    page it opens would let this person in. With nothing allowed it renders nothing, and Home has no menu. %>
<% family_study = policy(FamilyStudy).create? %>
<% personal_study = policy(PersonalStudy.new(user_id: Current.user.id)).create? %>
<% note = policy(PersonalNote.new(user_id: Current.user.id)).create? %>
<% family_goal = policy(Goal.new(household: Current.household)).create? %>
<% member = policy(Membership).create? %>
<% if family_study || personal_study || note || family_goal || member %>
  <%= render(Primer::Alpha::ActionMenu.new(menu_id: "home-new-menu", anchor_align: :end, classes: "home-new-menu")) do |menu| %>
    <% menu.with_show_button(scheme: :primary, classes: "home-new-menu__button") do |button| %>
      <% button.with_leading_visual_icon(icon: :plus) %>
      <% button.with_trailing_action_icon(icon: :"triangle-down") %>
      New
    <% end %>
    <% if family_study %>
      <% menu.with_item(label: "Family study", href: new_household_family_study_path) { it.with_leading_visual_icon(icon: :book) } %>
    <% end %>
    <% if personal_study %>
      <% menu.with_item(label: "Personal study", href: new_household_personal_study_path) { it.with_leading_visual_icon(icon: :search) } %>
    <% end %>
    <% if note %>
      <% menu.with_item(label: "Note", href: new_household_personal_note_path) { it.with_leading_visual_icon(icon: :pencil) } %>
    <% end %>
    <% if family_goal %>
      <% menu.with_item(label: "Family goal", href: new_household_goal_path) { it.with_leading_visual_icon(icon: :goal) } %>
    <% end %>
    <% if member %>
      <% menu.with_divider %>
      <% menu.with_item(label: "Member", href: new_household_member_path) { it.with_leading_visual_icon(icon: :people) } %>
    <% end %>
  <% end %>
<% end %>
