<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body data-color-mode="<%= color_mode %>" data-light-theme="light" data-dark-theme="dark">
    <%# Pages outside a household: the Aglowy logo, then one centred column. Signed in, the logo is at the top left;
        signed out, the mark alone is centred above the column (docs/design/brand.md, Where it appears). %>
    <% if identity_signed_in? %>
      <header class="px-3 py-3">
        <%= render LogoComponent.new(href: root_path) %>
      </header>
    <% else %>
      <header class="d-flex flex-justify-center pt-6">
        <%= render LogoComponent.new(href: root_path, size: :large) %>
      </header>
    <% end %>

    <main class="container-sm px-3 <%= identity_signed_in? ? "py-5" : "pt-4 pb-5" %>">
      <%= render "shared/flash" %>
      <%= render "shared/impersonation_banner" %>
      <%= yield %>
    </main>
  </body>
</html>
