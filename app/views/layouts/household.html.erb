<!DOCTYPE html>
<html lang="en">
  <head>
    <%# "<Page> · <Household> · Aglowy". safe_join escapes the household name. %>
    <%= render "layouts/head", title: safe_join([ content_for(:title), Current.household.name, "Aglowy" ].compact, " · ") %>
  </head>

  <body data-color-mode="<%= color_mode %>" data-light-theme="light" data-dark-theme="dark">
    <%# AppShellComponent renders the page's one <main>. A page can name its own item with content_for :nav_item,
        as a personal goal's page does for My goals. A page with a notes editor adds the scripture picker. %>
    <%= render AppShellComponent.new(membership: Current.membership, selected_item: (content_for(:nav_item).presence || controller_path.split("/").first).to_sym) do %>
      <%= render "shared/flash" %>
      <%= render "shared/impersonation_banner" %>
      <%= yield %>
      <%= content_for(:scripture_picker) %>
    <% end %>
  </body>
</html>
