<!DOCTYPE html>
<html lang="en">
  <head>
    <%# "<Page> · <Household> · Aglowy". safe_join escapes the household name. %>
    <%= render "layouts/head", title: safe_join([ content_for(:title), Current.household.name, "Aglowy" ].compact, " · ") %>
  </head>

  <body data-color-mode="auto" data-light-theme="light" data-dark-theme="dark">
    <%# AppShellComponent renders the page's one <main>. %>
    <%= render AppShellComponent.new(membership: Current.membership, selected_item: controller_name.to_sym) do %>
      <%= render "shared/flash" %>
      <%= render "shared/impersonation_banner" %>
      <%= yield %>
    <% end %>
  </body>
</html>
