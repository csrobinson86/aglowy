<%# locals: (title: content_for(:title) || "Aglowy") %>
<title><%= title %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Aglowy">
<meta name="mobile-web-app-capable" content="yes">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= content_for :head %>

<%# The manifest makes Aglowy installable, which an iPhone needs for push (docs/design/notifications.md, Push).
    household_id: nil keeps HouseholdScoped#default_url_options out of it. %>
<%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json, household_id: nil) %>

<%# The Two flames: the SVG mark, a 32 px PNG for browsers without SVG favicons, and the app icon for an iPhone's
    Home Screen. theme-color is the logo's ink (docs/design/brand.md, Files and Colours). %>
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="icon" href="/icon.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#1F2328">

<%# Lexxy's stylesheet from its gem, so Propshaft resolves the files it @imports (Sass would leave them as 404s). %>
<%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
<%# Includes all stylesheet files in app/assets/stylesheets %>
<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
