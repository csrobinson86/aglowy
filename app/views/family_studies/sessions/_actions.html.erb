<%# locals: (family_study:, study_session:) %>
<%# "This session only" changes (scheduling rules 6 and 7), in the header from md up. Cancelling asks first in the
    Primer Dialog in family_studies/sessions/_cancel_dialog, never a browser confirm. %>
<%= render(Primer::Beta::Button.new(tag: :a, href: edit_household_family_study_session_path(family_study_id: family_study, id: study_session), mr: 2)) do |button| %>
  <% button.with_leading_visual_icon(icon: :pencil) %>
  Edit this session
<% end %>

<% if study_session.canceled? %>
  <%= primer_form_with(url: household_family_study_session_cancellation_path(family_study_id: family_study, session_id: study_session), method: :delete) do |f| %>
    <%= render FamilyStudies::Sessions::CancellationForm.new(f, label: "Restore this session") %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::Button.new(scheme: :danger, data: { show_dialog_id: "cancel-session" })) { "Cancel this session" } %>
<% end %>
