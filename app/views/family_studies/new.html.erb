<% content_for :title, "Schedule a family study" %>

<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: household_family_studies_path) { "Family studies" } %>
  <% breadcrumbs.with_item(href: new_household_family_study_path) { "New" } %>
<% end %>
<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "Schedule a family study" } %>
  <% subhead.with_description { Current.household.name } %>
<% end %>

<% ai_drafts = FamilyStudies::DraftPolicy.new(Current.membership, FamilyStudy::Draft).create? %>
<% schedule_form = capture do %>
<div class="container-md ml-0" data-controller="repeat-field" data-repeat-field-url-value="<%= new_household_family_study_path %>">
  <%= render "family_studies/storage_warning", household: Current.household %>
  <%# A goal step that another adult linked while this form was open. %>
  <% if @scheduling.errors[:base].any? %>
    <%= render(Primer::Beta::Flash.new(scheme: :danger, mb: 4)) { @scheduling.errors[:base].to_sentence } %>
  <% end %>
  <%= primer_form_with(model: @scheduling, url: household_family_studies_path) do |f| %>
    <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
      <% box.with_body do %>
        <%# Where focus goes once "Use this draft" fills the form on a phone. %>
        <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, mb: 3, tabindex: -1, data: { ai_draft_target: "topicHeading" })) { "Topic" } %>
        <%= render FamilyStudies::ScheduleForm.new(f, section: :topic) %>
      <% end %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
      <% box.with_body do %>
        <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, mb: 3)) { "When" } %>
        <%= render FamilyStudies::ScheduleForm.new(f, section: :when) %>
        <%# The Repeat choices depend on the date, so the server re-renders this frame when it changes (scheduling rule 5). %>
        <%= turbo_frame_tag :family_study_scheduling_repeat, class: "d-block mt-3", data: { repeat_field_target: "frame", action: "turbo:before-frame-render->repeat-field#keepRepeat" } do %>
          <%= render FamilyStudies::ScheduleForm.new(f, section: :repeat) %>
        <% end %>
      <% end %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
      <% box.with_body(id: "schedule-resources", data: { controller: "resource-links" }) do %>
        <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, mb: 3)) { "Resources" } %>
        <%= tag.p "No resources yet. Add links from jw.org or wol.jw.org, or your own files.", class: "color-fg-muted mb-3", hidden: @scheduling.link_urls.any?, data: { resource_links_target: "blank" } %>
        <%# Saved on the first session (scheduling rule 1). %>
        <ul id="schedule-links" class="list-style-none" data-resource-links-target="list">
          <% @scheduling.link_urls.each do |url| %>
            <%= render "family_studies/link", url: url %>
          <% end %>
        </ul>
        <template data-resource-links-target="template"><%= render "family_studies/link", url: "" %></template>
        <%= render FamilyStudies::ScheduleForm.new(f, section: :resources) %>
        <div class="mt-3">
          <%= render FileDropComponent.new(name: "family_study_scheduling[files][]", direct_upload_url: household_direct_uploads_path,
                                           blobs: @scheduling.file_blobs, error: @scheduling.errors[:files].to_sentence.presence) %>
        </div>
      <% end %>
    <% end %>

    <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
      <% box.with_body do %>
        <%= render "family_studies/sessions/notes/field", form: f, heading: true, ai_draft: ai_drafts %>
      <% end %>
    <% end %>

    <%= render FamilyStudies::ScheduleForm.new(f, section: :actions, cancel_path: @goal_step ? household_goal_path(id: @goal_step.goal_id) : household_family_studies_path) %>
  <% end %>
</div>
<% end %>

<%# Heads and adults get "Plan it with AI" beside the form, stacked under it on narrow screens (docs/design/family-studies.md,
    The panel). The form keeps its width either way. %>
<%# "Use this draft" fills the form from the panel (the ai-draft controller), so the controller sits around both. %>
<% if ai_drafts %>
  <%= render(Primer::Alpha::Layout.new(first_in_source: :main, stacking_breakpoint: :lg, classes: "schedule-study",
        data: { controller: "ai-draft", ai_draft_resource_links_outlet: "#schedule-resources", action: "lexxy:change->ai-draft#notesEdited" })) do |layout| %>
    <% layout.with_main { schedule_form } %>
    <% layout.with_sidebar(width: :wide, col_placement: :end, row_placement: :end, classes: "schedule-study__ai") do %>
      <%# From a personal study, the panel opens on Describe with the study filled in, and nothing sent yet. %>
      <%= render FamilyStudies::AiPanelComponent.new(household: Current.household, user: Current.user, open: params[:ai_panel] == "open" || @from_study.present?,
            draft: (FamilyStudy::Draft.new(length_minutes: FamilyStudies::AiPanelComponent::DEFAULT_LENGTH, prompt: @from_study.family_study_prompt) if @from_study)) %>
    <% end %>
  <% end %>
<% else %>
  <%= schedule_form %>
<% end %>
