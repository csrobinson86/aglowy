<% content_for :title, "Sign up" %>

<%= render(Primer::Beta::Heading.new(tag: :h1, mb: 4)) { "Sign up" } %>

<%= primer_form_with(model: @signup, url: signup_path) do |f| %>
  <%= render Signups::SignupForm.new(f) %>
<% end %>

<p class="mt-4">
  Already have an account?
  <%= render(Primer::Beta::Link.new(href: new_identity_session_path, underline: true)) { "Log in" } %>
</p>
