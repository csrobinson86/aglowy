<% content_for :title, "Daily brief" %>
<%# It's personal: Turbo's in-memory snapshot ignores the controller's no-store, so without this Back after a sign-out
    and another person's sign-in would show this brief again until the fresh page arrived. %>
<% turbo_exempts_page_from_cache %>

<%# The brief (docs/design/daily-brief.md, The brief, its states; frames brief-today.png, brief-base.png and
    phone-brief.png): the newest one on or before today, beside Today in Aglowy. Written by AI, its thread, its sections
    and the pages it used; otherwise the parts from its own copy of the plan, with a Banner when the AI part failed, was
    refused or stopped, and Try again. Being written, the progress and Stop above it; under today's, Another angle or
    Write it with AI (How a writing runs). Before the first, Prepare today's brief; with only an earlier one, it's shown
    with its date and when today's is ready. Nothing is shown of a writing while it's being written (Trap 9). With
    evening questions, the morning has This evening beside it, and ?part=evening shows them in place of the sections
    (This evening; frame brief-evening.png). Written, For the children is beside it, with Share with the family on
    today's (For the children, and sharing). %>
<%= render "daily_briefs/header", brief: @brief, evening: @evening %>

<% if @brief %>
  <% if @brief.on < @today %>
    <%= render(Primer::Alpha::Banner.new(icon: :clock, mb: 4)) do |banner| %>
      <% if @plan.ready? %>
        <% banner.with_action_content do %>
          <%= primer_form_with(url: household_daily_brief_path) do |f| %>
            <%= render DailyBriefs::PrepareForm.new(f) %>
          <% end %>
        <% end %>
        This is your brief from <%= @brief.on.strftime("%A") %>. Today's hasn't been made yet.
      <% else %>
        This is your brief from <%= @brief.on.strftime("%A") %>. Today's brief is ready by <%= @plan.ready_by %>.
      <% end %>
    <% end %>
  <% end %>

  <% writing, latest, today = @brief.writing, @brief.writings.last, @brief.on == @today %>
  <% if latest&.writing? %>
    <%= render "daily_briefs/writings/progress", writing: latest, earlier: writing.present? %>
  <% end %>
  <% if writing %>
    <%= render "daily_briefs/thread", brief: @brief, writing:, evening: @evening %>
  <% elsif latest&.status.in?(DailyBrief::Writing::UNWRITTEN_STATUSES) %>
    <%= render(Primer::Alpha::Banner.new(scheme: latest.stopped? ? :default : :warning, icon: :info, mb: 4)) do |banner| %>
      <% if today && @brief.writings_left.positive? %>
        <% banner.with_action_content do %>
          <%= primer_form_with(url: household_daily_brief_writings_path) do |f| %>
            <%= render DailyBriefs::WritingForm.new(f, label: "Try again") %>
          <% end %>
        <% end %>
      <% end %>
      <%= unwritten_message(latest) %>
    <% end %>
  <% end %>

  <%= render(Primer::Alpha::Layout.new(stacking_breakpoint: :lg)) do |layout| %>
    <% layout.with_main do %>
      <% if @evening %>
        <%= render "daily_briefs/evening", brief: @brief, writing:, open: @brief.evening_open?(Time.current) %>
      <% else %>
        <%= render "daily_briefs/brief", brief: @brief, writing: %>
      <% end %>
      <% if today %>
        <%= render "daily_briefs/writings/actions", brief: @brief, latest:, write_now: params[:write] == "first" %>
      <% end %>
    <% end %>
    <% layout.with_sidebar(width: :wide, col_placement: :end, row_placement: :end) do %>
      <%= render TodayComponent.new(household: Current.household, viewer: Current.user, meeting_helper: false,
            manage_events: policy(Household::Event).create?, title: "Today in Aglowy", heading_tag: :h2, today: @today) %>
      <% if writing && @brief.section?(:children) && (children = writing.section(:children)&.compact_blank.presence) %>
        <%= render "daily_briefs/children", brief: @brief, children:, today:, evening: @evening %>
      <% end %>
      <% if !@evening && @brief.evening_questions.any? %>
        <%= render "daily_briefs/evening_note", brief: @brief, open: @brief.evening_open?(Time.current) %>
      <% end %>
      <% if writing %>
        <%= render "daily_briefs/sources", writing: %>
      <% end %>
    <% end %>
  <% end %>

  <% if @brief.evening_questions.any? %>
    <div class="daily-brief-switch d-md-none"><%= render "daily_briefs/switch", evening: @evening, full_width: true %></div>
  <% end %>
<% else %>
  <%= render(Primer::Beta::Blankslate.new(narrow: true)) do |blankslate| %>
    <% blankslate.with_visual_icon(icon: :"north-star") %>
    <% blankslate.with_heading(tag: :h2) { "Your first brief is ready tomorrow morning" } %>
    <% blankslate.with_description do %>
      It's made from your plan by <%= @plan.ready_by %> each day. If you'd like one now, it can be made for today.
    <% end %>
  <% end %>
  <div class="d-flex flex-justify-center">
    <%= primer_form_with(url: household_daily_brief_path) do |f| %>
      <%= render DailyBriefs::PrepareForm.new(f, scheme: :primary) %>
    <% end %>
  </div>
<% end %>
