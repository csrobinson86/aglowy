<%# locals: (brief:, writing: nil) %>
<%# The brief's sections (docs/design/daily-brief.md, The brief; frames brief-today.png and brief-base.png), built by
    brief_sections from the newest written writing and the brief's own copy of the plan. A section with nothing to show
    isn't drawn. Every AI field is escaped, and every scripture is a link made by Bible::Reference. %>
<% sections = brief_sections(brief, writing) %>
<div class="daily-brief">
  <% sections.values_at(:daily_text, :reading).compact.each do |section| %>
    <%= render section %>
  <% end %>

  <% if (pair = sections.values_at(:quality, :appreciation).compact).any? %>
    <div class="daily-brief__pair">
      <% pair.each do |section| %>
        <%= render section %>
      <% end %>
    </div>
  <% end %>

  <% sections.values_at(:focus, :faith).compact.each do |section| %>
    <%= render section %>
  <% end %>
</div>
