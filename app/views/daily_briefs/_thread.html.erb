<%# locals: (brief:, writing:, evening: false) %>
<%# Today's thread: the AI's one sentence that ties the day together, and the day's flow under it as links to the
    sections (docs/design/daily-brief.md, The brief; frames brief-today.png and brief-evening.png), which are on the
    morning's page when this is the evening's, and then not prefetched on hover: the brief's page marks it seen (Trap 5).
    Escaped, like every AI field. %>
<section class="daily-brief-thread mb-4" aria-labelledby="daily-brief-thread-heading">
  <p class="daily-brief-thread__kicker" id="daily-brief-thread-heading">Today's thread</p>
  <p class="daily-brief-thread__text"><%= writing.section(:thread) %></p>
  <% if (flow = brief_flow(brief, writing)).any? %>
    <nav aria-label="Today's flow" data-turbo-prefetch="false">
      <ol class="daily-brief-thread__flow">
        <% flow.each do |text, anchor| %>
          <li class="daily-brief-thread__step"><%= render(Primer::Beta::Link.new(href: evening ? household_daily_brief_path(anchor:) : "##{anchor}")) { text } %></li>
        <% end %>
      </ol>
    </nav>
  <% end %>
</section>
