<%# locals: (goal:, household:) %>
<%# Shares a personal goal into the household in the URL only, like a meeting note (meeting_notes/_sharing).
    Sharing asks first in the Primer Dialog in goals/_dialogs, never a browser confirm; stopping is one click and can be
    shared again. %>
<% if goal.shared_with?(household) %>
  <%= primer_form_with(url: household_goal_sharing_path(goal_id: goal), method: :delete, class: "mr-2") do |f| %>
    <%= render Goals::LifecycleForm.new(f, label: "Stop sharing") %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::Button.new(mr: 2, data: { show_dialog_id: "share-goal" })) do |button| %>
    <% button.with_leading_visual_icon(icon: :people) %>
    Share with household
  <% end %>
<% end %>
