<%# locals: (goal:) %>
<%# A row per step, then the add-step row for whoever may change the steps (frame milestone-goal.png). %>
<%# By goal_id, so the unsaved step doesn't join goal.steps and the counts. %>
<% editable = policy(Goal::Step.new(goal_id: goal.id)).create? %>
<div id="goal-steps">
  <%= render(Primer::Beta::BorderBox.new) do |box| %>
    <% box.with_header(display: :flex, flex_wrap: :wrap, align_items: :center) do %>
      <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 5, mr: 2)) { "Steps" } %>
      <%# Someone who may tick only their own parts (a child), on a goal still taking ticks (frame milestone-goal-child.png). %>
      <% if goal.family? && goal.open? && !policy(goal).update? %>
        <span class="color-fg-muted f6 ml-auto">You can tick the steps that are yours</span>
      <% end %>
    <% end %>
    <% goal.steps.each do |step| %>
      <% box.with_row(p: 0) { render "goals/steps/step", step:, editable: } %>
    <% end %>
    <% if editable %>
      <% box.with_footer(bg: :subtle) { render "goals/steps/new", goal:, step: Goal::Step.new } %>
    <% end %>
  <% end %>
</div>
