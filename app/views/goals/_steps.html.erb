<%# locals: (goal:) %>
<%# A row per step, then the add-step row for whoever may change the steps (frame milestone-goal.png). %>
<%# By goal_id, so the unsaved step doesn't join goal.steps and the counts. %>
<% editable = policy(Goal::Step.new(goal_id: goal.id)).create? %>
<div id="goal-steps">
  <%= render(Primer::Beta::BorderBox.new) do |box| %>
    <% box.with_header(display: :flex, flex_wrap: :wrap, align_items: :center) do %>
      <%# Focusable, for dialog-opener when the last step's panel removes it. %>
      <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 5, mr: 2, id: "goal-steps-heading", tabindex: -1)) { "Steps" } %>
      <%# Someone who may tick only their own parts (a child), on a goal still taking ticks (frame milestone-goal-child.png). %>
      <% if goal.family? && goal.open? && !policy(goal).update? %>
        <span class="color-fg-muted f6 ml-auto">You can tick the steps that are yours</span>
      <% end %>
    <% end %>
    <% goal.steps.each do |step| %>
      <% box.with_row(p: 0) { render "goals/steps/step", step:, editable: } %>
    <% end %>
    <%# On a phone the form waits behind "+ Add step", the list's last row; from md up it always shows, its hidden
        attribute overridden (docs/design/phone.md, rule 7; frame phone-goal-add-step.png). A refused add replaces only
        #new-goal-step, so the form stays open with its errors. %>
    <% if editable %>
      <% box.with_footer(bg: :subtle, p: 0, data: { controller: "add-row" }) do %>
        <%= render(Primer::Beta::Button.new(scheme: :invisible, block: true, align_content: :start, display: [ nil, nil, :none ], classes: "add-row__button",
                                            data: { action: "add-row#open", add_row_target: "button" })) do |button| %>
          <% button.with_leading_visual_icon(icon: :plus) %>
          Add step
        <% end %>
        <div class="add-row__form p-3" hidden data-add-row-target="form">
          <%= render "goals/steps/new", goal:, step: Goal::Step.new %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <%# Each step's phone panel, opened by its row's "›" (docs/design/phone.md, A goal, The step panel). Outside the steps'
      Turbo Frames, so a tick redraws only the panel's body and it stays open. Saving or removing a step redraws all of
      this with the panel open, so dialog-removal lets the page scroll again. dialog-opener puts focus back on the
      step's "›", which a tick, Save or Remove has replaced. %>
  <div data-controller="dialog-removal dialog-opener" data-dialog-opener-fallback-value="goal-steps-heading" data-action="close->dialog-opener#refocus:capture">
    <% goal.steps.each do |step| %>
      <%= render(Primer::Alpha::Dialog.new(id: dom_id(step, :panel), title: step.title, position: :center, position_narrow: :bottom)) do |dialog| %>
        <% dialog.with_body(pb: 3) { render "goals/steps/panel", step:, editable: } %>
      <% end %>
    <% end %>
  </div>
</div>
