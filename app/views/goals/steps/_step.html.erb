<%# locals: (step:, editable:, editing: false, stale: false, checked_ids: nil, focused: nil) %>
<%# The step's Turbo Frame: its row, and for whoever may change it, the edit form in place of the row. %>
<%# The parts this person may tick; someone who may tick only their own (a child) sees those rows highlighted. %>
<% tickable = step.parts.select { policy(step.new_tick(it)).create? } %>
<%= turbo_frame_tag step do %>
  <%= render GoalStepComponent.new(step:, editing:, tickable:, focused:, highlighted: tickable.any? && !policy(step.goal).update?) do |component| %>
    <% if editable %>
      <% component.with_edit_form do %>
        <% if stale %>
          <%= render(Primer::Beta::Flash.new(scheme: :warning, icon: :alert, mb: 3)) { "Someone else changed this step. Here's the latest." } %>
        <% end %>
        <div class="d-flex flex-items-start gap-2">
          <%= primer_form_with(model: step, url: household_goal_step_path(goal_id: step.goal, id: step), namespace: dom_id(step), class: "flex-auto min-width-0",
                               data: { action: "change->goal-step#warn" }) do |f| %>
            <%= render Goals::Steps::StepForm.new(f, section: :fields, members: step.goal.assignable_users, editing: true, checked_ids:) %>
            <p class="color-fg-attention mb-3" aria-live="polite" data-goal-step-target="warning"></p>
            <%= render Goals::Steps::StepForm.new(f, section: :actions, editing: true) %>
          <% end %>
          <%# Primer forms have no icon button. show_tooltip: false keeps the aria-label, which Primer's tooltip would replace. %>
          <%= primer_form_with(url: household_goal_step_path(goal_id: step.goal, id: step), method: :delete) do %>
            <%= render(Primer::Beta::IconButton.new(icon: :trash, type: :submit, scheme: :danger, show_tooltip: false, "aria-label": "Remove step: #{step.title}")) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
