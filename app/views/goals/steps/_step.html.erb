<%# locals: (step:, editable:, editing: false, stale: false, checked_ids: nil, focused: nil) %>
<%# The step's Turbo Frame: its row, and for whoever may change it, the edit form in place of the row. %>
<%= turbo_frame_tag step do %>
  <%= render GoalStepComponent.new(step:, editing:, focused:, **goal_step_arguments(step)) do |component| %>
    <% if editable %>
      <% component.with_edit_form do %>
        <% if stale %>
          <%= render(Primer::Beta::Flash.new(scheme: :warning, icon: :alert, mb: 3)) { "Someone else changed this step. Here's the latest." } %>
        <% end %>
        <div class="d-flex flex-items-start gap-2">
          <%= render "goals/steps/edit_form", step:, namespace: dom_id(step), checked_ids:, stale: %>
          <%# Primer forms have no icon button. show_tooltip: false keeps the aria-label, which Primer's tooltip would replace. %>
          <%= primer_form_with(url: household_goal_step_path(goal_id: step.goal, id: step), method: :delete) do %>
            <%= render(Primer::Beta::IconButton.new(icon: :trash, type: :submit, scheme: :danger, show_tooltip: false, "aria-label": "Remove step: #{step.title}")) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
