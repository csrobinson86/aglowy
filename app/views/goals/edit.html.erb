<% content_for :title, "Edit goal" %>
<% goal_nav_item(@goal) %>

<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: goal_list_path(@goal)) { goal_list_name(@goal) } %>
  <% breadcrumbs.with_item(href: household_goal_path(id: @goal)) { @goal.title_in_database } %>
  <% breadcrumbs.with_item(href: edit_household_goal_path(id: @goal)) { "Edit" } %>
<% end %>
<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "Edit goal" } %>
<% end %>

<% if @stale %>
  <%= render(Primer::Beta::Flash.new(scheme: :warning, icon: :alert, mb: 3)) { "Someone else changed this goal. Here's the latest." } %>
<% end %>

<div class="container-md ml-0">
  <%= primer_form_with(model: @goal, url: household_goal_path(id: @goal)) do |f| %>
    <%= render Goals::GoalForm.new(f, section: :fields, personal: @goal.personal?) %>
    <div class="mt-4">
      <%= render Goals::GoalForm.new(f, section: :actions, cancel_path: household_goal_path(id: @goal), submit_label: "Save") %>
    </div>
  <% end %>
</div>
