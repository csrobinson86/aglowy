<% content_for :title, "New family goal" %>

<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: household_goals_path) { "Family goals" } %>
  <% breadcrumbs.with_item(href: new_household_goal_path) { "New" } %>
<% end %>
<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "New family goal" } %>
<% end %>

<div class="container-md ml-0">
  <%= primer_form_with(model: @goal, url: household_goals_path) do |f| %>
    <%= render Goals::GoalForm.new(f, section: :fields) %>
    <%= render(Primer::Beta::BorderBox.new(bg: :subtle, color: :muted, my: 4)) do |box| %>
      <% box.with_body do %>
        You'll add the steps next, on the goal's page. Give each step to everyone or to one person, and turn any step into a family study.
      <% end %>
    <% end %>
    <%= render Goals::GoalForm.new(f, section: :actions, cancel_path: household_goals_path) %>
  <% end %>
</div>
