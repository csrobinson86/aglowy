<% content_for :title, @goal.title %>

<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: household_goals_path) { "Family goals" } %>
  <% breadcrumbs.with_item(href: household_goal_path(id: @goal)) { @goal.title } %>
<% end %>

<%= render Primer::Beta::Subhead.new(mb: 3) do |subhead| %>
  <%# Wraps, so the Milestone Label drops below a long title instead of squeezing it (frame phone-goal.png). %>
  <% subhead.with_heading(tag: :h1, display: :flex, flex_wrap: :wrap, align_items: :center, classes: "min-width-0") do %>
    <span class="mr-2 wb-break-word min-width-0"><%= @goal.title %></span>
    <%= render(Primer::Beta::Label.new) { "Milestone" } %>
  <% end %>
  <% if policy(@goal).edit? %>
    <% subhead.with_actions(display: :flex) do %>
      <%= render(Primer::Beta::Button.new(tag: :a, href: edit_household_goal_path(id: @goal), mr: 2)) { "Edit" } %>
      <%= render "goals/menu", goal: @goal %>
    <% end %>
  <% end %>
  <% subhead.with_description do %>
    Target <%= @goal.target_on.strftime("%B %-d, %Y") %> · Set by <%= @goal.set_by.name %>
  <% end %>
<% end %>
<% if @goal.body.present? %>
  <%= simple_format(@goal.body, class: "mb-4") %>
<% end %>

<% unless @goal.open? %>
  <%= render "goals/finished", goal: @goal %>
<% end %>
<%= render "goals/progress", goal: @goal %>
<%= render "goals/steps", goal: @goal %>
