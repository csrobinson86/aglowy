<% content_for :title, @goal.title %>

<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: household_goals_path) { "Family goals" } %>
  <% breadcrumbs.with_item(href: household_goal_path(id: @goal)) { @goal.title } %>
<% end %>

<%# Subhead can't put the kind Label beside the title, so the header follows frame milestone-goal.png with utilities. %>
<div class="pb-3 mb-4 border-bottom">
  <div class="d-flex flex-column flex-md-row flex-md-items-start mb-2">
    <div class="d-flex flex-wrap flex-items-center gap-2 flex-auto min-width-0">
      <%= render(Primer::Beta::Heading.new(tag: :h1, font_size: 2, classes: "min-width-0 wb-break-word")) { @goal.title } %>
      <%= render(Primer::Beta::Label.new) { "Milestone" } %>
    </div>
    <%# The "…" menu (complete, archive, delete) joins Edit here in the next stories. %>
    <div class="d-flex gap-2 flex-shrink-0 mt-2 mt-md-0 ml-md-3">
      <% if policy(@goal).edit? %>
        <%= render(Primer::Beta::Button.new(tag: :a, href: edit_household_goal_path(id: @goal))) { "Edit" } %>
      <% end %>
    </div>
  </div>
  <p class="color-fg-muted mb-2">Target <%= @goal.target_on.strftime("%B %-d, %Y") %> · Set by <%= @goal.set_by.name %></p>
  <% if @goal.body.present? %>
    <%= simple_format(@goal.body, class: "mb-0") %>
  <% end %>
</div>

<%= render "goals/progress", goal: @goal %>
<%= render "goals/steps", goal: @goal %>
