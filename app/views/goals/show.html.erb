<% content_for :title, @goal.title %>
<% goal_nav_item(@goal) %>

<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: goal_list_path(@goal)) { goal_list_name(@goal) } %>
  <% breadcrumbs.with_item(href: household_goal_path(id: @goal)) { @goal.title } %>
<% end %>

<%= render Primer::Beta::Subhead.new(mb: 3) do |subhead| %>
  <%# Wraps, so the Milestone Label drops below a long title instead of squeezing it (frame phone-goal.png). %>
  <% subhead.with_heading(tag: :h1, display: :flex, flex_wrap: :wrap, align_items: :center, classes: "min-width-0") do %>
    <span class="mr-2 wb-break-word min-width-0"><%= @goal.title %></span>
    <%= render(Primer::Beta::Label.new(mr: 2)) { "Milestone" } %>
    <%# The owner sees who can read it; a member it's shared with sees whose it is (docs/design/goals.md, Pages). %>
    <% if @goal.personal? %>
      <% if policy(@goal).share? %>
        <% label = @goal.shared_households.any? ? "Shared with #{@goal.shared_households.map(&:name).to_sentence}" : "Private" %>
        <%= render(Primer::Beta::Label.new(scheme: :secondary, title: label, classes: "css-truncate css-truncate-overflow min-width-0")) do %>
          <%= render(Primer::Beta::Octicon.new(@goal.shared_households.any? ? :people : :lock, mr: 1)) %><%= label %>
        <% end %>
      <% else %>
        <%= render(Primer::Beta::Label.new(scheme: :accent, title: "Shared by #{@goal.user.name}", classes: "css-truncate css-truncate-overflow min-width-0")) do %>
          <%= render(Primer::Beta::Octicon.new(:people, mr: 1)) %>Shared by <%= @goal.user.name %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% if policy(@goal).edit? %>
    <% subhead.with_actions(display: :flex) do %>
      <%= render(Primer::Beta::Button.new(tag: :a, href: edit_household_goal_path(id: @goal), mr: 2)) { "Edit" } %>
      <% if @goal.personal? %>
        <%= render "goals/sharing", goal: @goal, household: Current.household %>
      <% end %>
      <%= render "goals/menu", goal: @goal %>
    <% end %>
  <% end %>
  <% subhead.with_description do %>
    <%# A personal goal is always set by its owner, so it doesn't say so. %>
    <%= [ "Target #{@goal.target_on.strftime("%B %-d, %Y")}", ("Set by #{@goal.set_by.name}" if @goal.family?) ].compact.join(" · ") %>
    <%# The owner's own tags on a personal goal; nothing on a family goal or for a member reading it shared. %>
    <%= render TagEditorComponent.new(taggable: @goal, user: Current.user, household: Current.household) %>
  <% end %>
<% end %>
<% if @goal.body.present? %>
  <%= simple_format(@goal.body, class: "mb-4") %>
<% end %>

<% unless @goal.open? %>
  <%= render "goals/finished", goal: @goal %>
<% end %>
<%= render "goals/progress", goal: @goal %>
<%= render "goals/steps", goal: @goal %>
