<%# locals: (status:, can_create:, mine: false, tag: nil) %>
<%# tag: the tag My goals is filtered by, which nothing on this tab carries. %>
<%= render Primer::Beta::Blankslate.new(border: true, spacious: true) do |blankslate| %>
  <% blankslate.with_visual_icon(icon: mine ? :flag : :goal) %>
  <% case tag ? "tagged" : status %>
  <% when "tagged" %>
    <% blankslate.with_heading(tag: :h2) { "No goals tagged ##{tag}" } %>
    <% blankslate.with_description { "Add a tag from a goal's page, under its title." } %>
  <% when "active" %>
    <% if mine %>
      <% blankslate.with_heading(tag: :h2) { "No goals of your own yet" } %>
      <% blankslate.with_description { "Set a goal just for you and break it into steps. Only you can see it." } %>
      <% blankslate.with_primary_action(href: new_household_my_goal_path) { "New goal" } %>
    <% else %>
      <% blankslate.with_heading(tag: :h2) { "No family goals yet" } %>
      <% if can_create %>
        <% blankslate.with_description { "Set a goal the whole household can work toward, then break it into steps." } %>
        <% blankslate.with_primary_action(href: new_household_goal_path) { "New goal" } %>
      <% else %>
        <% blankslate.with_description { "When a parent sets a family goal, it will show up here." } %>
      <% end %>
    <% end %>
  <% when "completed" %>
    <% blankslate.with_heading(tag: :h2) { "Nothing completed yet" } %>
    <% blankslate.with_description { "Goals marked complete show up here." } %>
  <% when "archived" %>
    <% blankslate.with_heading(tag: :h2) { "Nothing archived" } %>
    <% blankslate.with_description { "Goals put away show up here, finished or not." } %>
  <% when "shared" %>
    <% blankslate.with_heading(tag: :h2) { "Nothing shared here yet" } %>
    <% blankslate.with_description { "When someone in the household shares a goal of their own, it shows up here." } %>
  <% end %>
<% end %>
