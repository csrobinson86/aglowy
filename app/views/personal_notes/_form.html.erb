<%# locals: (personal_note:, url:) %>
<%# A note's title, collection and body, with "Save note" (frame note.png): the New note page, and a note's page, which
    opens straight into editing. Why the last save was refused shows above it. "Saved" reads the saved note. %>
<% if personal_note.errors.any? %>
  <%= render(Primer::Alpha::Banner.new(scheme: :danger, mb: 3)) { personal_note.errors.full_messages.to_sentence } %>
<% end %>
<%= primer_form_with(model: personal_note, url:) do |f| %>
  <%= render PersonalNotes::NoteForm.new(f, collections: Current.user.collections.for_notes.positioned) %>
  <div class="my-3">
    <%= render "meeting_notes/notes_field", form: f, attribute: :body, label: "Note", visually_hidden: true, tall: true,
          placeholder: "What you want to come back to. Type a scripture, or use the Scripture button." %>
  </div>
  <div class="d-flex flex-items-center">
    <%= render PersonalNotes::SaveForm.new(f) %>
    <% if personal_note.persisted? %>
      <span class="f6 color-fg-muted ml-3">Saved <%= render(Primer::Beta::RelativeTime.new(datetime: personal_note.updated_at_in_database, tense: :past)) %></span>
    <% end %>
  </div>
<% end %>
