<%# locals: (collections:, selected:, tags:, tag:) %>
<%# Below md, the sidebar's collections and my tags in one menu, named for the collection showing (frame
    phone-notes.png). Each item links where its sidebar link does. New collection is in "+ New ▾" on a phone. %>
<%= render(Primer::Alpha::ActionMenu.new(menu_id: "personal-notes-menu", anchor_align: :start, classes: "personal-notes__menu")) do |menu| %>
  <%# A collection's name can be forty characters with no spaces, so the button's label wraps, even mid-word. %>
  <% menu.with_show_button(label_wrap: true, block: true, align_content: :start) do |button| %>
    <% button.with_trailing_action_icon(icon: :"triangle-down") %>
    <span class="wb-break-word"><%= selected&.name || "All notes" %></span>
  <% end %>
  <% menu.with_group do |group| %>
    <% group.with_heading(title: "Collections") %>
    <% notes_menu_item(group, label: "All notes", href: household_personal_notes_path(tag:), current: selected.nil?) %>
    <% collections.each do |collection| %>
      <% notes_menu_item(group, label: collection.name, href: household_personal_notes_path(collection: collection.id, tag:), current: collection == selected) %>
    <% end %>
  <% end %>
  <% if tags.any? %>
    <% menu.with_group do |group| %>
      <% group.with_heading(title: "My tags") %>
      <% tags.each do |each_tag| %>
        <% notes_menu_item(group, label: "##{each_tag.name}", href: household_personal_notes_path(tag: each_tag.name, collection: selected&.id), current: each_tag.name == tag) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
