<% content_for :title, "New note" %>
<%# A color chosen but not saved recolors the card; Turbo's cache would bring it back on Back as if saved, so the page is
    never cached (docs/design/notes.md, Colors). %>
<% turbo_exempts_page_from_cache %>

<%= render(Primer::Beta::Breadcrumbs.new(mb: 2)) do |breadcrumbs| %>
  <% breadcrumbs.with_item(href: household_personal_notes_path) { "Notes" } %>
  <% breadcrumbs.with_item(href: new_household_personal_note_path) { "New note" } %>
<% end %>
<%= render Primer::Beta::Subhead.new do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "New note" } %>
<% end %>

<%# The note card a note's page draws, in the chosen color, so a new note shows its color while it's written and after a
    refused save. Tags come once it's saved, on the note's page: the tag editor adds them to a saved note. %>
<div class="container-md ml-0">
  <div class="note-card note-card--<%= @personal_note.drawn_color %> p-md-4">
    <%= render "personal_notes/form", personal_note: @personal_note, url: household_personal_notes_path %>
  </div>
</div>
