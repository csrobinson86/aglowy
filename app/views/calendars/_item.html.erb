<%# locals: (item:, today:, meeting_helper:, manage_events:, chip:) -%>
<%# A meeting opens the viewer's note for it, or Today's meeting for a child with the helper on its day; a study session
    opens its page, and one not stored yet opens Family studies; a household event opens its edit dialog for heads and
    adults, and for children isn't a link, with its location and note under the title (docs/design/calendar.md, Links).
    An all-day event in the week's band names its days in place of a time. The title says what it is, so color is never
    the only cue. %>
<% classes = [ "calendar-item", "calendar-item--#{item.kind.dasherize}", { "calendar-item--chip": chip } ] %>
<% content = capture do %>
  <% if !item.all_day %>
    <span class="calendar-item__time"><%= calendar_time(item.starts_at) %></span>
  <% elsif !chip %>
    <span class="calendar-item__time"><%= calendar_days(item.dates) %></span>
  <% end %>
  <span class="calendar-item__title"><%= item.title %></span>
  <% if item.subtitle && !chip %>
    <span class="calendar-item__subtitle"><%= item.subtitle %></span>
  <% end %>
  <% if item.event? && item.source.note.present? && !manage_events && !chip %>
    <span class="calendar-item__subtitle"><%= item.source.note %></span>
  <% end %>
<% end %>
<% if item.event? && manage_events %>
  <%= link_to content, edit_household_calendar_event_path(id: item.source), class: classes, data: { turbo_frame: "calendar_event_dialog" } %>
<% elsif item.event? %>
  <%= tag.div content, class: classes %>
<% elsif item.meeting? && meeting_helper && item.on?(today) %>
  <%= link_to content, household_todays_meeting_path, class: classes %>
<% elsif item.meeting? %>
  <%= button_to household_meeting_notes_path, params: { meeting_note: { kind: item.source.kind, week_of: item.source.week_of.iso8601 } }, class: classes, form_class: "calendar-item__form" do %>
    <%= content %>
  <% end %>
<% elsif item.source.persisted? %>
  <%= link_to content, household_family_study_session_path(family_study_id: item.source.family_study_id, id: item.source), class: classes %>
<% else %>
  <%= link_to content, household_family_studies_path, class: classes %>
<% end %>
