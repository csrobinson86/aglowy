<% content_for :title, "Calendar" %>
<%# A saved household event refreshes the page, keeping the place on it. %>
<% turbo_refreshes_with method: :replace, scroll: :preserve %>
<% manage_events = policy(Household::Event).create? %>

<%# On a phone New stays beside the title and the description, which only explains the page, is hidden (docs/design/phone.md, Calendar). %>
<%= render Primer::Beta::Subhead.new(hide_border: true, mb: 0, classes: "page-header--phone-inline") do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "Calendar" } %>
  <% subhead.with_description(display: [ :none, nil, :block ]) { "#{Current.household.name}'s meetings, studies and events, with your own times." } %>
  <% subhead.with_actions do %>
    <%# The New menu, the same button as Home's, at every size; each item opens its dialog (docs/design/calendar.md, The page). %>
    <%= render(Primer::Alpha::ActionMenu.new(menu_id: "calendar-new-menu", anchor_align: :end, classes: "calendar-new-menu")) do |menu| %>
      <% menu.with_show_button(scheme: :primary) do |button| %>
        <% button.with_leading_visual_icon(icon: :plus) %>
        <% button.with_trailing_action_icon(icon: :"triangle-down") %>
        New
      <% end %>
      <% menu.with_item(label: "My time", href: new_household_personal_time_path, content_arguments: { data: { turbo_frame: "personal_time_dialog" } }) { it.with_leading_visual_icon(icon: :clock) } %>
      <% if manage_events %>
        <% menu.with_item(label: "Household event", href: new_household_calendar_event_path, content_arguments: { data: { turbo_frame: "calendar_event_dialog" } }) { it.with_leading_visual_icon(icon: :calendar) } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<% if @calendar.viewer_in_another_zone? %>
  <p class="color-fg-muted">Times are in <%= @calendar.zone_name %>, the household's time zone.</p>
<% end %>

<%# Today, previous and next, the range, and Week or Month; each a link keeping view, date and hide (frame calendar-week.png).
    On a phone it's one row with the range, shorter, between previous and next; Month isn't offered, and Show opens its
    dialog (frame phone-calendar.png). %>
<div class="calendar-toolbar">
  <div class="calendar-toolbar__nav">
    <%= render(Primer::Beta::Button.new(tag: :a, href: calendar_page_path(@period.view, Current.household.today, hide: @hide))) { "Today" } %>
    <% unit = @period.month? ? "month" : "week" %>
    <%= render Primer::Beta::IconButton.new(tag: :a, href: calendar_page_path(@period.view, @period.previous_date, hide: @hide), icon: :"chevron-left", "aria-label": "Previous #{unit}", show_tooltip: false) %>
    <%= render Primer::Beta::IconButton.new(tag: :a, href: calendar_page_path(@period.view, @period.next_date, hide: @hide), icon: :"chevron-right", "aria-label": "Next #{unit}", show_tooltip: false, classes: "calendar-toolbar__next") %>
    <%= render(Primer::Beta::Heading.new(tag: :h2, ml: [ 0, nil, 2 ], classes: "calendar-toolbar__range")) do %>
      <% if @period.short_title == @period.title %>
        <%= @period.title %>
      <% else %>
        <span class="d-none d-md-inline"><%= @period.title %></span><span class="d-md-none"><%= @period.short_title %></span>
      <% end %>
    <% end %>
  </div>
  <%= render Primer::Beta::IconButton.new(icon: :filter, "aria-label": "Show on the calendar", show_tooltip: false, display: [ nil, nil, :none ], data: { show_dialog_id: "calendar-show-dialog" }) %>
  <div class="d-none d-md-block">
    <%= render(Primer::Alpha::SegmentedControl.new("aria-label": "View")) do |control| %>
      <% { "week" => "Week", "month" => "Month" }.each do |view, label| %>
        <% control.with_item(tag: :a, href: calendar_page_path(view, @period.date, hide: @hide), label:, selected: @period.view == view) %>
      <% end %>
    <% end %>
  </div>
</div>

<%# Show beside the calendar, above it on narrower screens, and in a dialog on a phone. Not Primer's Layout: the app
    shell's own Layout hides any sidebar inside it below md. %>
<div class="d-flex flex-column flex-lg-row gap-4">
  <div class="col-lg-3 flex-shrink-0 d-none d-md-block">
    <%= render "calendars/show_choices", calendar: @calendar, period: @period, hide: @hide %>
  </div>

  <div class="flex-auto min-width-0">
    <% if @calendar.nothing_planned? %>
      <%= render Primer::Beta::Blankslate.new(border: true, mb: 3) do |blankslate| %>
        <% blankslate.with_visual_icon(icon: :calendar) %>
        <% blankslate.with_heading(tag: :h2) { "Nothing on the calendar yet." } %>
        <% if policy(Current.household).manage_meetings? %>
          <% blankslate.with_primary_action(href: household_settings_meetings_path) { "Set your meeting times" } %>
        <% end %>
        <% if manage_events %>
          <% blankslate.with_secondary_action(href: new_household_calendar_event_path, data: { turbo_frame: "calendar_event_dialog" }) { "Add household event" } %>
        <% end %>
      <% end %>
    <% end %>

    <% today = Current.household.today %>
    <% if @period.month? %>
      <%# A phone has no month grid: it lists the month's weeks day by day, as it does a week. %>
      <div class="d-none d-md-block">
        <%= render "calendars/month", calendar: @calendar, period: @period, today:, hide: @hide, meeting_helper: @meeting_helper, manage_events: %>
      </div>
      <div class="d-md-none">
        <%= render "calendars/week", calendar: @calendar, days: @period.days, today:, meeting_helper: @meeting_helper, manage_events: %>
      </div>
    <% else %>
      <%= render "calendars/week", calendar: @calendar, days: @period.days, today:, meeting_helper: @meeting_helper, manage_events: %>
    <% end %>
  </div>
</div>

<%# The household event dialog loads here (Calendar::EventsController), and the "my time" dialog (PersonalTimesController). %>
<%= turbo_frame_tag "calendar_event_dialog" %>
<%= turbo_frame_tag "personal_time_dialog" %>

<%= render(Primer::Alpha::Dialog.new(id: "calendar-show-dialog", title: "Show on the calendar")) do |dialog| %>
  <% dialog.with_body(pb: 3) do %>
    <%= render "calendars/show_choices", calendar: @calendar, period: @period, hide: @hide, namespace: "phone" %>
  <% end %>
<% end %>
