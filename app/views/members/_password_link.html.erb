<%# locals: (member:, identity:, message:) %>
<%# The link is a bearer secret: shown here only, never stored, logged, emailed or put in a flash (docs/design/invitations.md, Traps).
    household_id: nil keeps HouseholdScoped#default_url_options out of it. %>
<% link = edit_password_setup_url(token: identity.generate_token_for(:password_setup), household_id: nil) %>
<% name = member.user.first_name %>

<div class="container-md ml-0">
  <%= render(Primer::Alpha::Banner.new(scheme: :success, icon: :check, mb: 4)) do %>
    <%= message %><strong><%= identity.username %></strong>.
  <% end %>

  <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
    <% box.with_body do %>
      <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4, mb: 2)) { "Open this link on #{name}'s device" } %>
      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted)) do %>
        <%= name %> will choose a password there. The link works once, for the next 12 hours. Don't share it outside the family.
      <% end %>
      <div class="d-flex flex-items-end" data-controller="clipboard">
        <div class="flex-1 min-width-0 mr-2">
          <%= render(Primer::Alpha::TextField.new(name: :password_link, id: "password-link", label: "Password link", visually_hide_label: true,
                                                  value: link, readonly: true, full_width: true, monospace: true,
                                                  data: { clipboard_target: "source" })) %>
        </div>
        <%= render(Primer::Beta::Button.new(data: { action: "clipboard#copy" })) do |button| %>
          <% button.with_leading_visual_icon(icon: :copy) %>
          Copy link
        <% end %>
        <p class="sr-only" role="status" data-clipboard-target="status"></p>
      </div>
      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, mt: 2, mb: 0)) do %>
        If it expires, or <%= name %> forgets the password later, use "New password link" on the Members page.
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Beta::Button.new(tag: :a, href: household_members_path)) { "Back to members" } %>
</div>
