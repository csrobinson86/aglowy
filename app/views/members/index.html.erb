<% content_for :title, "Members" %>

<% invite = policy(Invitation).create? %>
<% add_member = policy(Membership).create? %>
<%# One New menu at every size, beside the title on a phone too (docs/design/phone.md, Members). Each item shows when
    its page would let this person in; with neither, there's no menu. %>
<%= render Primer::Beta::Subhead.new(classes: "page-header--phone-inline") do |subhead| %>
  <% subhead.with_heading(tag: :h1) { "Members" } %>
  <% if invite || add_member %>
    <% subhead.with_actions do %>
      <%= render(Primer::Alpha::ActionMenu.new(menu_id: "members-new-menu", anchor_align: :end, classes: "members__new-menu")) do |menu| %>
        <% menu.with_show_button(scheme: :primary) do |button| %>
          <% button.with_leading_visual_icon(icon: :plus) %>
          <% button.with_trailing_action_icon(icon: :"triangle-down") %>
          New
        <% end %>
        <% if invite %>
          <% menu.with_item(label: "Invite by email", href: new_household_invitation_path) { it.with_leading_visual_icon(icon: :mail) } %>
        <% end %>
        <% if add_member %>
          <% menu.with_item(label: "Add without a login", href: new_household_member_path) { it.with_leading_visual_icon(icon: :"person-add") } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render Primer::Beta::BorderBox.new(id: "members", mb: 4) do |box| %>
  <% box.with_header do %>
    <h2 class="Box-title"><%= pluralize(@memberships.size, "member") %></h2>
  <% end %>
  <% @memberships.each do |membership| %>
    <% box.with_row(display: :flex, align_items: :center) do %>
      <%= render "members/member", membership:, show_sign_in: invite %>
    <% end %>
  <% end %>
<% end %>

<% if @invitations.present? %>
  <%= render Primer::Beta::BorderBox.new(id: "invitations") do |box| %>
    <% box.with_header do %>
      <h2 class="Box-title">Invited, not joined yet</h2>
    <% end %>
    <% @invitations.each do |invitation| %>
      <% box.with_row(display: :flex, align_items: :center, flex_wrap: [ :nowrap, nil, :wrap ]) do %>
        <%= render "invitations/invitation", invitation: %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
