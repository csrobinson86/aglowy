<%# locals: (membership:, show_sign_in:) %>
<span class="avatar avatar-5 circle d-flex flex-shrink-0 flex-items-center flex-justify-center mr-3 color-bg-accent color-fg-accent text-bold" aria-hidden="true"><%= membership.user.name.first %></span>
<div class="flex-1 min-width-0">
  <div class="text-bold css-truncate css-truncate-overflow"><%= membership.user.name %></div>
  <% if show_sign_in %>
    <div class="color-fg-muted text-small css-truncate css-truncate-overflow"><%= how_they_sign_in(membership.user) %></div>
  <% end %>
</div>
<%= render(Primer::Beta::Label.new(scheme: membership.head? ? :accent : :secondary, ml: 2)) { membership.role.humanize } %>
<%# A head here can read a child's personal studies while the child has a study AI grant (docs/design/personal-study.md, Children). %>
<% if ChildStudyPolicy.new(Current.membership, membership).show? %>
  <%= render(Primer::Beta::Button.new(tag: :a, href: household_member_personal_studies_path(member_id: membership), ml: 2,
                                      aria: { label: "Read #{membership.user.name}'s personal study" })) { "Personal study" } %>
<% end %>
<% if policy(membership).give_login? %>
  <%= render(Primer::Beta::Button.new(tag: :a, href: new_household_member_login_path(member_id: membership), ml: 2,
                                      aria: { label: "Give a login to #{membership.user.name}" })) { "Give a login" } %>
<% elsif policy(membership).new_password_link? %>
  <%# Without Turbo, like Give a login: the link page is rendered, not redirected to. %>
  <%= primer_form_with(url: household_member_password_link_path(member_id: membership), class: "ml-2", data: { turbo: false }) do |f| %>
    <%= render Members::PasswordLinkForm.new(f, name: membership.user.name) %>
  <% end %>
<% end %>
