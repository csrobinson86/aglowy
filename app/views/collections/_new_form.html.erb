<%# locals: (collection:, section: "studies") %>
<%# In the New collection Dialog, on Personal study or on Notes (section: "notes"). A refused name comes back as this
    form by Turbo Stream, so the Dialog stays open. %>
<%= primer_form_with(model: collection, url: household_collections_path, id: dom_id(collection, :new), namespace: dom_id(collection, :new)) do |f| %>
  <%= render Collections::CollectionForm.new(f, submit_label: "Create collection", section:, error: collection.errors[:base].to_sentence.presence) %>
<% end %>
